#!/usr/bin/env bash
set -euo pipefail

# pr-committee — review a GitHub PR with a committee of frontier models.
#
# Round 1: each model independently reviews the same brief (PR metadata,
# full changed-file contents, diff) and emits structured findings. The
# reviewers cannot see each other — independence is what makes cross-model
# agreement a meaningful confidence signal.
# Optional round 2 (--debate): each reviewer sees the others' findings
# anonymized and agrees/disputes/adds.
# Chair: one strong model merges the final round — dedupes, counts
# agreement, checks each finding against the diff, and writes the report.
#
# Model calls go through Headlong's bin/llm, so OPENROUTER_API_KEY from the
# repo .env (or the state home's .env) is all the auth needed for every vendor.
#
# Usage:
#   tools/pr-committee [PR_NUMBER] [options]
#   tools/pr-committee --diff RANGE [options]
#
# Options:
#   --diff RANGE     Review a local git commit range (e.g. main..HEAD or
#                    abc123..def456) instead of a GitHub PR. Everything is
#                    read from the local repo; gh is not used and --post is
#                    unavailable. Useful for re-verifying fixes already
#                    merged, or reviewing before anything is pushed.
#   --focus TEXT     Steer the review (e.g. "concurrency around the
#                    dispatcher; ignore style"). Injected into every
#                    reviewer's brief and prioritized by the chair.
#   --models CSV     Reviewer roster (OpenRouter slugs or anything bin/llm
#                    accepts). Default: $PRC_MODELS or the built-in four.
#   --chair MODEL    Synthesis model. Default: $PRC_CHAIR or claude-opus-5.
#   --debate         Add the cross-examination round before synthesis.
#   --out DIR        Run directory. Default: <state-home>/pr-committee/<run>
#   --post           Post the final report as a PR comment (off by default).
#   --dry-run        Build the brief and print size stats; call no models.
#
# Environment:
#   PRC_MODELS            Default roster (comma-separated)
#   PRC_CHAIR             Default chair model
#   PRC_MAX_FILE_BYTES    Per-file cap in the brief (default 60000)
#   PRC_MAX_FILES_BYTES   Total full-file budget in the brief (default 250000)

DEFAULT_MODELS="anthropic/claude-opus-5,openai/gpt-5.5,google/gemini-3.1-pro-preview,x-ai/grok-4.6"

MODELS="${PRC_MODELS:-$DEFAULT_MODELS}"
CHAIR="${PRC_CHAIR:-anthropic/claude-opus-5}"
FOCUS=""
DEBATE=0
POST=0
DRY=0
OUT=""
PR=""
DIFF_RANGE=""
MAX_FILE_BYTES="${PRC_MAX_FILE_BYTES:-60000}"
MAX_FILES_BYTES="${PRC_MAX_FILES_BYTES:-250000}"

die() { echo "pr-committee: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --diff)    DIFF_RANGE="${2:?--diff requires a git range}"; shift 2 ;;
        --focus)   FOCUS="${2:?--focus requires a value}"; shift 2 ;;
        --models)  MODELS="${2:?--models requires a value}"; shift 2 ;;
        --chair)   CHAIR="${2:?--chair requires a value}"; shift 2 ;;
        --debate)  DEBATE=1; shift ;;
        --post)    POST=1; shift ;;
        --dry-run) DRY=1; shift ;;
        --out)     OUT="${2:?--out requires a value}"; shift 2 ;;
        -h|--help) sed -n '4,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)        die "unknown option: $1" ;;
        *)         PR="$1"; shift ;;
    esac
done

# Committee calls are non-streamed: nothing arrives until the model finishes,
# so bin/llm's low-speed stall guard (100 B/s over 60s) would abort any
# reviewer that thinks for more than a minute — which frontier models on a
# ~100k-token brief reliably do. Disable it and allow long single attempts.
# A pre-set environment still wins.
export LLM_SPEED_TIME="${LLM_SPEED_TIME:-0}"
export LLM_MAX_TIME="${LLM_MAX_TIME:-1800}"

command -v jq  >/dev/null || die "jq is required"
command -v llm >/dev/null || die "llm (shellm bin/llm) must be on PATH"
[[ -n "$DIFF_RANGE" && -n "$PR" ]] && die "pass either a PR number or --diff RANGE, not both"
if [[ -z "$DIFF_RANGE" ]]; then
    command -v gh >/dev/null || die "gh CLI is required (or use --diff RANGE for a local review)"
elif (( POST )); then
    die "--post needs a PR target; not available with --diff"
fi

cd "$(git rev-parse --show-toplevel)"
STAMP=$(date +%Y%m%d-%H%M%S)

# ---------------------------------------------------------------------------
# Gather the brief: metadata, full changed files, diff
# ---------------------------------------------------------------------------

# State home for run dirs: HEADLONG_HOME/SHELLM_HOME if set; else ~/.headlong.
_pc_home="${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}"

if [[ -n "$DIFF_RANGE" ]]; then
    # Local range mode: everything from git, nothing from GitHub.
    [[ "$DIFF_RANGE" == *..* ]] || die "--diff wants an A..B range (e.g. main..HEAD)"
    git diff --stat "$DIFF_RANGE" >/dev/null 2>&1 || die "invalid git range: $DIFF_RANGE"
    HEAD_REF="${DIFF_RANGE##*..}"; HEAD_REF="${HEAD_REF:-HEAD}"
    REPO=$(basename "$(git rev-parse --show-toplevel)")
    TARGET="range $DIFF_RANGE"
    TITLE="$DIFF_RANGE ($(git rev-list --count "$DIFF_RANGE") commits)"
    OUT="${OUT:-$_pc_home/pr-committee/${REPO}-diff-${DIFF_RANGE//[^A-Za-z0-9._-]/-}-${STAMP}}"
    mkdir -p "$OUT"
    echo "== $TARGET in $REPO"
    echo "== run dir: $OUT"

    git diff "$DIFF_RANGE" > "$OUT/diff.patch"
    git diff --name-only "$DIFF_RANGE" > "$OUT/files.txt"
    BRIEF="$OUT/brief.md"
    {
        echo "# Change set under review: $TITLE"
        echo
        echo "Repository: $REPO (local)  |  Head: $(git rev-parse --short "$HEAD_REF")"
        echo
        echo "## Commits in the range (message bodies carry the intent)"
        echo
        git log --reverse --format='### %h %s%n%n%b' "$DIFF_RANGE"
        echo
        if [[ -n "$FOCUS" ]]; then
            echo "## PRIORITY FOCUS from the requester"
            echo
            echo "$FOCUS"
            echo
        fi
        echo "## Full contents of changed files (post-change, for context)"
        echo
    } > "$BRIEF"
    fetch_file() { git show "$HEAD_REF:$1" 2>/dev/null; }
else
    REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)
    # Default PR: the sole open one, if there is exactly one.
    if [[ -z "$PR" ]]; then
        # No mapfile: bash-4 only, and macOS's /bin/bash is 3.2.
        open_prs=()
        while IFS= read -r _n; do [[ -n "$_n" ]] && open_prs+=("$_n"); done \
            < <(gh pr list --state open --json number -q '.[].number')
        [[ ${#open_prs[@]} -eq 1 ]] || die "pass a PR number (${#open_prs[@]} open PRs)"
        PR="${open_prs[0]}"
    fi
    TARGET="PR #$PR"
    OUT="${OUT:-$_pc_home/pr-committee/${REPO//\//-}-pr${PR}-${STAMP}}"
    mkdir -p "$OUT"
    echo "== $TARGET on $REPO"
    echo "== run dir: $OUT"

    gh pr view "$PR" --json title,body,author,headRefName,headRefOid,files > "$OUT/pr.json"
    gh pr diff "$PR" > "$OUT/diff.patch"
    jq -r '.files[].path' "$OUT/pr.json" > "$OUT/files.txt"

    TITLE=$(jq -r .title "$OUT/pr.json")
    AUTHOR=$(jq -r .author.login "$OUT/pr.json")
    HEAD_SHA=$(jq -r .headRefOid "$OUT/pr.json")

    BRIEF="$OUT/brief.md"
    {
        echo "# Pull request #$PR: $TITLE"
        echo
        echo "Repository: $REPO  |  Author: $AUTHOR  |  Head: $(jq -r .headRefName "$OUT/pr.json") @ ${HEAD_SHA:0:9}"
        echo
        echo "## PR description"
        echo
        jq -r '.body // "(no description)"' "$OUT/pr.json"
        echo
        if [[ -n "$FOCUS" ]]; then
            echo "## PRIORITY FOCUS from the requester"
            echo
            echo "$FOCUS"
            echo
        fi
        echo "## Full contents of changed files (post-change, for context)"
        echo
    } > "$BRIEF"
    # Contents come from the API at the PR head — works for fork PRs without
    # touching local git state. Deleted files 404 and are skipped (the diff
    # still shows the deletion).
    fetch_file() {
        local enc
        enc=$(jq -rn --arg p "$1" '$p|@uri')
        gh api -H "Accept: application/vnd.github.raw" \
            "repos/$REPO/contents/$enc?ref=$HEAD_SHA" 2>/dev/null
    }
fi

# A per-file and a total byte budget keep the brief inside a sane token count.
budget=$MAX_FILES_BYTES
while IFS= read -r path; do
    if (( budget <= 0 )); then
        echo "(remaining files omitted: full-file budget exhausted; see diff)" >> "$BRIEF"
        break
    fi
    if content=$(fetch_file "$path") && [[ -n "$content" ]]; then
        content=${content:0:$MAX_FILE_BYTES}
        {
            echo "### $path"
            echo '````'
            printf '%s\n' "$content"
            [[ ${#content} -eq $MAX_FILE_BYTES ]] && echo "...(truncated at ${MAX_FILE_BYTES} bytes)"
            echo '````'
            echo
        } >> "$BRIEF"
        budget=$(( budget - ${#content} ))
    else
        echo "### $path — not fetchable at head (likely deleted); see diff" >> "$BRIEF"
        echo >> "$BRIEF"
    fi
done < "$OUT/files.txt"

{
    echo "## The diff under review"
    echo
    echo '````diff'
    cat "$OUT/diff.patch"
    echo '````'
} >> "$BRIEF"

echo "== brief: $(wc -c < "$BRIEF") bytes ($(wc -l < "$OUT/files.txt" | tr -d ' ') files, $(wc -c < "$OUT/diff.patch") bytes of diff)"
if (( DRY )); then
    echo "== dry run: no models called. Brief at $BRIEF"
    exit 0
fi

# ---------------------------------------------------------------------------
# Prompts
# ---------------------------------------------------------------------------

cat > "$OUT/sys-reviewer.txt" <<EOF
You are one member of an independent code-review committee examining a
proposed change set (a pull request or commit range). Other frontier models are reviewing the same brief in
parallel; you cannot see their work and must not speculate about it.
Your value to the committee is an honest, independent, evidence-grounded
review.

Rules:
- Ground every finding in the provided files/diff; quote the relevant
  lines. Never invent code that is not in the brief.
- If you suspect a problem but the brief lacks the context to confirm it,
  report it with low confidence and say exactly what is missing.
- Prefer a few verified findings over many speculative ones. Do not pad
  with praise or restate the PR description.
- Style nits only when they cause real risk of confusion or bugs.
$( [[ -n "$FOCUS" ]] && printf '%s\n' "- The requester set a PRIORITY FOCUS (in the brief). Weight your effort toward it, but still report any blocker you notice outside it." )

Output EXACTLY this structure and nothing else:

VERDICT: approve | request-changes | needs-discussion
SUMMARY: <2-4 sentences>

Then a JSON array in a \`\`\`json fence. Each element:
{
  "file": "path",
  "line": <int or null>,
  "severity": "blocker" | "major" | "minor" | "nit",
  "confidence": <0.0-1.0>,
  "category": "correctness" | "security" | "concurrency" | "data-loss" | "perf" | "maintainability" | "other",
  "title": "<one line>",
  "detail": "<what is wrong, with quoted evidence>",
  "suggestion": "<concrete fix, or null>"
}
An empty array is a valid and respectable answer.
EOF

# ---------------------------------------------------------------------------
# Round 1: independent parallel reviews
# ---------------------------------------------------------------------------

IFS=',' read -r -a ROSTER <<< "$MODELS"
safe() { echo "${1//[\/:]/-}"; }

run_round() {  # $1=round label; stdin arrives per-model from $2-template files
    local round="$1"; shift
    local pids=() model
    for model in "${ROSTER[@]}"; do
        local in out err
        in="$OUT/in-$round-$(safe "$model").md"
        out="$OUT/review-$round-$(safe "$model").md"
        err="$OUT/err-$round-$(safe "$model").log"
        ( llm -m "$model" --no-stream --system-prompt-file "$OUT/sys-reviewer.txt" \
              < "$in" > "$out" 2> "$err" ) &
        pids+=($!)
    done
    local ok=0 i=0
    for model in "${ROSTER[@]}"; do
        if wait "${pids[$i]}"; then
            ok=$((ok+1)); echo "   ✓ $model"
        else
            echo "   ✗ $model failed (see err-$round-$(safe "$model").log)" >&2
        fi
        i=$((i+1))
    done
    (( ok >= 1 )) || die "every reviewer failed in round $round"
}

echo "== round 1: ${#ROSTER[@]} independent reviews in parallel..."
for model in "${ROSTER[@]}"; do cp "$BRIEF" "$OUT/in-1-$(safe "$model").md"; done
run_round 1

FINAL_ROUND=1

# ---------------------------------------------------------------------------
# Round 2 (optional): cross-examination
# ---------------------------------------------------------------------------

if (( DEBATE )); then
    echo "== round 2: cross-examination..."
    for model in "${ROSTER[@]}"; do
        in="$OUT/in-2-$(safe "$model").md"
        cp "$BRIEF" "$in"
        {
            echo
            echo "## Committee round 2"
            echo
            echo "You already reviewed this PR. Your round-1 review:"
            echo
            cat "$OUT/review-1-$(safe "$model").md" 2>/dev/null || echo "(your round-1 call failed; review fresh)"
            echo
            echo "The other reviewers (anonymized) said:"
            echo
            n=0
            for other in "${ROSTER[@]}"; do
                [[ "$other" == "$model" ]] && continue
                n=$((n+1))
                echo "### Reviewer $n"
                cat "$OUT/review-$FINAL_ROUND-$(safe "$other").md" 2>/dev/null || echo "(failed)"
                echo
            done
            echo "Reconsider. Dispute findings you believe are wrong (say why,"
            echo "with evidence), adopt ones you missed if convinced, and keep"
            echo "yours if they stand. Output the SAME format as before —"
            echo "VERDICT, SUMMARY, JSON array — as your final position."
        } >> "$in"
    done
    run_round 2
    FINAL_ROUND=2
fi

# ---------------------------------------------------------------------------
# Chair: merge, verify, report
# ---------------------------------------------------------------------------

echo "== chair ($CHAIR): synthesizing..."

cat > "$OUT/sys-chair.txt" <<EOF
You chair a code-review committee. You receive the PR diff and the final
reviews from several frontier models. Produce the single report a
maintainer will act on.

- Merge findings that describe the same underlying issue; record which
  reviewers raised each (agreement across independent models is a strong
  signal; a lone low-confidence finding is not).
- Check every finding against the diff. Discard any that misread the
  code, and say why in a "Discarded" section — do not silently drop.
- Rank by severity, then agreement.
$( [[ -n "$FOCUS" ]] && printf '%s\n' "- The requester's priority focus was: ${FOCUS} — lead with findings relevant to it." )

Output a Markdown report, nothing else:

## Verdict
approve / request-changes / needs-discussion — one sentence why, and note
each reviewer's verdict.

## Findings
A table: # | Severity | File:line | Title | Raised by (n/${#ROSTER[@]}).
Then a subsection per finding: evidence, why it matters, suggested fix.

## Uncertain / needs human judgment

## Discarded (with reasons)
EOF

{
    echo "# $TARGET: $TITLE"
    echo
    echo "## The diff"
    echo '````diff'
    cat "$OUT/diff.patch"
    echo '````'
    echo
    n=0
    for model in "${ROSTER[@]}"; do
        n=$((n+1))
        echo "## Reviewer $n ($model)"
        cat "$OUT/review-$FINAL_ROUND-$(safe "$model").md" 2>/dev/null || echo "(this reviewer failed)"
        echo
    done
} > "$OUT/in-chair.md"

llm -m "$CHAIR" --no-stream --system-prompt-file "$OUT/sys-chair.txt" \
    < "$OUT/in-chair.md" > "$OUT/report.md"

{
    echo
    echo "---"
    echo "_Committee: ${MODELS} · chair: ${CHAIR}$( ((DEBATE)) && echo ' · with debate round')$( [[ -n "$FOCUS" ]] && echo " · focus: ${FOCUS}" )_"
} >> "$OUT/report.md"

echo
cat "$OUT/report.md"
echo
echo "== report: $OUT/report.md  (per-model reviews alongside it)"

if (( POST )); then
    gh pr comment "$PR" --body-file "$OUT/report.md"
    echo "== posted to PR #$PR"
fi
