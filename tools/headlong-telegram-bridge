#!/usr/bin/env bash
set -euo pipefail

# headlong-telegram-bridge — Telegram Bot API bridge for a Headlong identity.
#
# Usage:
#   headlong-telegram-bridge [ROOT] [--verbose]
#
# ROOT defaults to the headlong repo (parent of this script's directory).
# Requires uv. Configuration via env: TELEGRAM_BOT_TOKEN, TELEGRAM_ADMIN_ID,
# HEADLONG_TELEGRAM_IDENTITY (default audel), HEADLONG_WEB_URL (SHELLM_* names
# still honored as fallbacks).
#
# Note: the production systemd unit does NOT use this script — it execs the
# project venv directly so the bridge can run as its own user (uv would try
# to write the service-owned venv). This launcher is for local dev.

# Resolve through symlinks (install.sh --symlinks puts this on PATH), then
# fall back to the checkout recorded by install.sh / headlong-init.
ROOT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ ! -d "$ROOT_DIR/telegram" ]]; then
    _home="${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}"
    _rec=$(cat "$_home/app_dir" 2>/dev/null || true)
    if [[ -n "$_rec" && -d "$_rec/telegram" ]]; then ROOT_DIR="$_rec"
    elif [[ -d "$_home/app/telegram" ]]; then ROOT_DIR="$_home/app"
    else echo "headlong-telegram-bridge: can't find the headlong checkout (telegram/ missing); set HEADLONG_HOME or run from a checkout" >&2; exit 1
    fi
fi

command -v uv >/dev/null 2>&1 || { echo "headlong-telegram-bridge: uv is required (https://docs.astral.sh/uv/)" >&2; exit 1; }

# First arg is ROOT if it isn't a flag; all remaining args pass through.
if [[ $# -gt 0 && "${1:0:1}" != "-" ]]; then
    serve_root="$1"
    shift
else
    serve_root="$ROOT_DIR"
fi

exec uv run --project "$ROOT_DIR/telegram" headlong-telegram-bridge "$serve_root" "$@"
