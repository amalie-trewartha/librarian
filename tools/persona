#!/usr/bin/env bash
set -euo pipefail

# persona — talk to and manage a Headlong identity by name, from anywhere.
# No cd, no `identity shell` needed.
#
# headlong-init links each identity's name to this tool (e.g. `ada`), so the
# name IS the command:
#
#   ada                    chat with them (TUI if built, simple loop otherwise)
#   ada say <message>      send one message and wait briefly for the reply
#   ada start / stop       resume / pause their mind (the thinkers) and the dash
#   ada status             mind + dash status
#   ada dash               start the dashboard if needed and open it
#   ada shell              subshell with their environment (advanced)
#   ada bugreport          bundle logs + trajectory (secrets scrubbed) to share
#
#   persona <name> ...     the same, for any identity, without the name link
#   persona ...            ...or the default identity

die() { printf 'persona: error: %s\n' "$*" >&2; exit 1; }

# HEADLONG_* env names win; the SHELLM_* internal names stay because the
# tools underneath (thinkers, llm, shellm) still read them.
# State home: HEADLONG_HOME/SHELLM_HOME if set; else ~/.headlong.
SHELLM_HOME="${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}"
SHELLM_APP_DIR="${HEADLONG_APP_DIR:-${SHELLM_APP_DIR:-}}"
SHELLM_WEB_ARGS="${HEADLONG_WEB_ARGS:-${SHELLM_WEB_ARGS:-}}"

# ---------------------------------------------------------------------------
# Locate the checkout and the identity
# ---------------------------------------------------------------------------

_resolve_app_dir() {
    if [[ -n "${SHELLM_APP_DIR:-}" ]]; then
        printf '%s' "$SHELLM_APP_DIR"
        return 0
    fi
    local script_dir
    script_dir="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
    if [[ -f "$script_dir/../bin/shellm" ]]; then
        (cd "$script_dir/.." && pwd)
        return 0
    fi
    local recorded
    recorded=$(cat "$SHELLM_HOME/app_dir" 2>/dev/null || true)
    if [[ -n "$recorded" && -f "$recorded/bin/shellm" ]]; then
        printf '%s' "$recorded"
        return 0
    fi
    if [[ -f "$SHELLM_HOME/app/bin/shellm" ]]; then
        printf '%s' "$SHELLM_HOME/app"
        return 0
    fi
    return 1
}

APP_DIR=$(_resolve_app_dir) || die "can't find the headlong checkout. Set HEADLONG_APP_DIR=/path/to/headlong"
export PATH="$APP_DIR/bin:$APP_DIR/tools:$PATH"
IDENTITY_ROOT="$APP_DIR/.identities"

# Env files, real environment first (same layering as llm and headlong-init).
# Without this, activate's THINK_MODEL fallback can't see SHELLM_MODEL and
# the mind starts on the wrong model.
_load_env() {
    local envfile="$1"
    [[ -f "$envfile" ]] || return 1
    local key val
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        [[ -n "${!key+x}" ]] && continue
        # shellcheck disable=SC1090
        val=$(set -a; . "$envfile" 2>/dev/null; printf '%s' "${!key}") || continue
        export "$key=$val"
    done < <(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\2/p' "$envfile")
    return 0
}
_load_env "$APP_DIR/.env" || true
_load_env "$SHELLM_HOME/.env" || true

SELF=$(basename "$0")
NAME=""
if [[ "$SELF" == "persona" ]]; then
    # First arg is the identity name if it matches one; otherwise fall through
    # to the default identity and treat the arg as a subcommand.
    if [[ -n "${1:-}" && -d "$IDENTITY_ROOT/${1:-}" ]]; then
        NAME="$1"; shift
    fi
else
    NAME="$SELF"
fi
if [[ -z "$NAME" && -L "$IDENTITY_ROOT/default" ]]; then
    NAME=$(basename "$(readlink "$IDENTITY_ROOT/default")")
fi
[[ -n "$NAME" ]] || die "no identity given and no default set. Usage: persona <name> [command]"
[[ -d "$IDENTITY_ROOT/$NAME" ]] || die "no identity named '$NAME' in $IDENTITY_ROOT"

# The command name to show in messages (`ada stop` vs `persona ada stop`):
# the bare name only if it actually resolves to a persona link — it may
# instead be an unrelated command or a headlong tool (e.g. an identity named
# "chat").
CMD="persona $NAME"
if [[ "$(readlink "$(command -v "$NAME" 2>/dev/null)" 2>/dev/null)" == *"/persona" ]]; then
    CMD="$NAME"
fi

# ---------------------------------------------------------------------------
# Identity environment (what `identity shell` would give you, in-process)
# ---------------------------------------------------------------------------

_activate() {
    [[ -n "${IDENTITY_NAME:-}" ]] && return 0
    # activate is written for interactive shells; its internal greps may
    # legitimately fail, which would be fatal under set -e — relax around it.
    set +eu
    set +o pipefail
    # shellcheck disable=SC1090,SC1091
    source "$IDENTITY_ROOT/$NAME/activate" >/dev/null 2>&1
    set -eu
    set -o pipefail
    [[ -n "${IDENTITY_NAME:-}" ]] || die "activate did not set IDENTITY_NAME"
    # `chat send` needs a sender name in the identity's chatrc
    if [[ -n "${CHATRC:-}" ]] && ! grep -q '^default_send_from=' "$CHATRC" 2>/dev/null; then
        mkdir -p "$(dirname "$CHATRC")"
        printf 'default_send_from=operator\n' >> "$CHATRC"
    fi
}

_dispatcher_pid() {
    local pid
    pid=$(cat "$IDENTITY_ROOT/$NAME/run/dispatcher.pid" 2>/dev/null || true)
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid" && return 0
    return 1
}

# Messages in the root trajectory, one JSON object per line
_messages() {
    _activate
    traj cat "${ROOT_TRAJ_ID:-$TRAJ_ID}" --filter type=message --raw 2>/dev/null \
        | jq -c '.' 2>/dev/null || true
}

_print_incoming() {  # stdin: message JSON lines; prints ones from the identity
    jq -r --arg me "$NAME" 'select(.from == $me) | "\($me)> \(.content)"' 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_start() {
    _activate
    if _dispatcher_pid >/dev/null; then
        echo "$NAME's mind is already running."
    else
        thinkers start monolith
        echo "$NAME is thinking again."
    fi
    local url
    if url=$(_dash_start); then
        echo "dash: $url"
    fi
}

cmd_stop() {
    _activate
    if ! _dispatcher_pid >/dev/null; then
        echo "$NAME's mind is already stopped."
    else
        thinkers stop
    fi
    _dash_stop
    echo "$NAME is paused. Resume with: $CMD start"
}

cmd_status() {
    _activate
    local pid
    if pid=$(_dispatcher_pid); then
        echo "mind: running (dispatcher pid $pid)"
    else
        echo "mind: stopped   (resume with: $CMD start)"
    fi
    local wpid
    wpid=$(cat "$SHELLM_HOME/run/web.pid" 2>/dev/null || true)
    if [[ -n "$wpid" ]] && kill -0 "$wpid" 2>/dev/null; then
        echo "dash: $(grep -o 'http://[^ ]*' "$SHELLM_HOME/logs/web.log" 2>/dev/null | tail -1)"
    else
        echo "dash: stopped   (open with: $CMD dash)"
    fi
    echo
    thinkers status 2>/dev/null || true
}

cmd_shell() {
    exec env IDENTITY_DIR="$IDENTITY_ROOT" identity shell "$NAME"
}

# _dash_start — start the dash if it isn't running; print its URL on stdout.
# Progress goes to stderr. Returns non-zero (with a reason on stderr) if it
# can't be started, so callers decide whether that's fatal.
_dash_start() {
    local log="$SHELLM_HOME/logs/web.log" pidfile="$SHELLM_HOME/run/web.pid" pid url
    mkdir -p "$SHELLM_HOME/logs" "$SHELLM_HOME/run"
    pid=$(cat "$pidfile" 2>/dev/null || true)
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        command -v uv >/dev/null 2>&1 || { echo "the dash needs uv — run headlong-init to set it up" >&2; return 1; }
        # In a container, bind on all interfaces so a published port works
        if [[ -z "${SHELLM_WEB_ARGS:-}" && ( -f /.dockerenv || -f /run/.containerenv ) ]]; then
            SHELLM_WEB_ARGS="--host 0.0.0.0"
        fi
        echo "Starting the dash..." >&2
        : > "$log"
        # shellcheck disable=SC2086
        nohup headlong-web "$APP_DIR" ${SHELLM_WEB_ARGS:-} >>"$log" 2>&1 &
        printf '%s\n' "$!" > "$pidfile"
        local _
        for _ in $(seq 1 300); do
            grep -qE '(shellm|shelly|headlong)-web serving' "$log" 2>/dev/null && break
            kill -0 "$(cat "$pidfile")" 2>/dev/null || { tail -20 "$log" >&2; echo "the dash failed to start (log: $log)" >&2; return 1; }
            sleep 1
        done
    fi
    url=$(grep -o 'http://[^ ]*' "$log" 2>/dev/null | tail -1)
    [[ -n "$url" ]] || { echo "dash is running but no URL found in $log" >&2; return 1; }
    printf '%s\n' "$url"
}

# _dash_wait_ready URL — the "serving" log line is printed just before the
# server binds, so a browser opened on it can land on a connection error or a
# stale service-worker page. Poll until the URL answers (30s cap); never fails.
_dash_wait_ready() {
    local url="$1" _
    command -v curl >/dev/null 2>&1 || { sleep 2; return 0; }
    for _ in $(seq 1 60); do
        curl -fsS -o /dev/null --max-time 2 "$url" 2>/dev/null && return 0
        sleep 0.5
    done
    return 0
}

# _dash_stop — stop the dash started by _dash_start (or headlong-init). The
# pid file holds the `headlong-web` wrapper; take its whole process tree so
# the uv/python server underneath goes too.
_dash_stop() {
    local pidfile="$SHELLM_HOME/run/web.pid" pid
    pid=$(cat "$pidfile" 2>/dev/null || true)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        echo "Stopping the dash (PID $pid)..."
        _kill_tree "$pid" TERM
        local _
        for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
        kill -0 "$pid" 2>/dev/null && _kill_tree "$pid" KILL
    fi
    rm -f "$pidfile"
    return 0
}

_kill_tree() {  # _kill_tree PID SIGNAL — signal PID and all its descendants
    local c
    for c in $(pgrep -P "$1" 2>/dev/null); do _kill_tree "$c" "$2"; done
    kill -s "$2" "$1" 2>/dev/null || true
}

cmd_dash() {
    local url
    url=$(_dash_start) || die "couldn't start the dash"
    echo "$url"
    _dash_wait_ready "$url"
    case "$(uname -s)" in
        Darwin) open "$url" 2>/dev/null || true ;;
        Linux)
            if command -v xdg-open >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
                xdg-open "$url" 2>/dev/null || true
            fi
            ;;
    esac
}

cmd_say() {
    [[ $# -gt 0 ]] || die "usage: $CMD say <message>"
    _activate
    _dispatcher_pid >/dev/null || echo "(note: $NAME's mind is stopped — they won't answer until you run: $CMD start)"
    local before
    before=$(_messages | _print_incoming | wc -l | tr -d ' ')
    chat send "$*" >/dev/null
    echo "sent. waiting for $NAME (Ctrl-C to stop waiting — replies also appear in the dash)"
    local _
    for _ in $(seq 1 60); do
        sleep 2
        local now
        now=$(_messages | _print_incoming | wc -l | tr -d ' ')
        if [[ "$now" -gt "$before" ]]; then
            _messages | _print_incoming | tail -n "$((now - before))"
            return 0
        fi
    done
    echo "no reply yet — it'll show up in '$CMD' chat or the dash."
}

cmd_chat() {
    _activate
    if command -v headlong-tui >/dev/null 2>&1 || command -v shellm-tui >/dev/null 2>&1; then
        exec chat repl
    fi
    # Simple fallback loop when the Rust TUI isn't built
    _dispatcher_pid >/dev/null || echo "(note: $NAME's mind is stopped — they won't answer until you run: $CMD start)"
    echo "(simple chat — Ctrl-C or Ctrl-D to leave; build the TUI with cargo + install.sh for the full experience)"
    chat history 10 2>/dev/null || true
    local seen watcher
    seen=$(_messages | wc -l | tr -d ' ')
    (
        # Watch for new messages from the identity and print them as they land
        local_seen=$seen
        while :; do
            sleep 2
            total=$(_messages | wc -l | tr -d ' ')
            if [[ "$total" -gt "$local_seen" ]]; then
                printf '\n'
                _messages | tail -n "$((total - local_seen))" | _print_incoming
                printf 'you> '
                local_seen=$total
            fi
        done
    ) &
    watcher=$!
    trap 'kill "$watcher" 2>/dev/null || true' EXIT
    local line
    while IFS= read -r -p "you> " line; do
        [[ -z "$line" ]] && continue
        chat send "$line" >/dev/null
    done
    echo
}

# ---------------------------------------------------------------------------
# bugreport — one file to attach to a bug report
# ---------------------------------------------------------------------------

# Collects the identity dir (trajectory, rollups, memories, thinker logs,
# persona files), the state-home logs and a report.txt with versions and
# status, into ~/headlong-bugreport-<name>-<stamp>.tgz. The agent's workdir
# is left out (arbitrary user files, can be large). Every text file in the
# bundle goes through _redact_tree first: the literal values of every
# credential-looking variable from the env files and the live environment,
# `--var NAME=VALUE` for credential-looking names (older shellm-run rows still
# carry those), and anything shaped like an sk-... API key.
cmd_bugreport() {
    local out=""
    BUGREPORT_INCLUDE_WORKDIR=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)             out="${2:?--out requires a path}"; shift 2 ;;
            --include-workdir) BUGREPORT_INCLUDE_WORKDIR=1; shift ;;
            -h|--help)
                cat <<EOF
Usage: $CMD bugreport [--out FILE] [--include-workdir]

Bundle what a developer needs to debug $NAME into one .tgz you can attach to
a bug report: the identity (trajectory, rollups, memories, thinker logs),
the Headlong logs, and a report.txt with versions, status and the layout.
API keys and other credential-looking values are scrubbed; your .env is not
included. Look inside before sending if you are unsure:
    tar tzf FILE            # list
    tar xzf FILE            # unpack; then read headlong-bugreport-*/report.txt
EOF
                return 0 ;;
            *) die "bugreport: unknown option: $1" ;;
        esac
    done
    local stamp; stamp=$(date +%Y%m%d-%H%M%S)
    [[ -n "$out" ]] || out="$HOME/headlong-bugreport-$NAME-$stamp.tgz"
    local iddir="$IDENTITY_ROOT/$NAME"
    local stage; stage=$(mktemp -d "${TMPDIR:-/tmp}/headlong-bugreport.XXXXXX")
    # shellcheck disable=SC2064
    trap "rm -rf '$stage'" EXIT RETURN
    local top="$stage/headlong-bugreport-$NAME-$stamp"
    mkdir -p "$top/identity" "$top/home"

    echo "Collecting $NAME's identity..." >&2
    local excl=(--exclude='./workdir')
    [[ "$BUGREPORT_INCLUDE_WORKDIR" -eq 1 ]] && excl=()
    # Follow the default -> name symlink; copy files, not the symlink itself.
    # Skip single files over 50MB (noted in report.txt) so a runaway blob
    # doesn't turn the bundle into a gigabyte.
    local -a big=()
    while IFS= read -r -d '' f; do big+=("${f#./}"); done \
        < <(cd "$iddir" && find . -type f -size +50M -print0 2>/dev/null)
    local f; for f in "${big[@]+"${big[@]}"}"; do excl+=(--exclude="./$f"); done
    (cd "$iddir" && tar -cf - "${excl[@]+"${excl[@]}"}" .) | tar -xf - -C "$top/identity"

    # State-home bits: logs, status, app_dir pointer. Never .env.
    local h; for h in logs status.json app_dir; do
        if [[ -e "$SHELLM_HOME/$h" ]]; then cp -R "$SHELLM_HOME/$h" "$top/home/" 2>/dev/null || true; fi
    done

    # report.txt — what a developer asks for in the first reply, all at once.
    # Best effort: nothing in it may abort the bundle (no git, no df, ...).
    ( set +e; set +o pipefail; _bugreport_text "$iddir" "${big[@]+"${big[@]}"}" ) > "$top/report.txt" 2>&1 || true

    echo "Scrubbing secrets..." >&2
    _redact_tree "$top"

    tar -czf "$out" -C "$stage" "$(basename "$top")"
    echo >&2
    echo "Wrote $out ($(du -h "$out" | cut -f1))." >&2
    echo "Attach that file to your bug report. It has no API keys: your .env is" >&2
    echo "left out and credential-looking values are replaced with <redacted ...>." >&2
    echo "List what is inside with:  tar tzf $out" >&2
    printf '%s\n' "$out"
}

# _bugreport_text IDDIR [BIGFILE...] — the body of report.txt on stdout.
# Runs with set -e / pipefail off (see the caller).
_bugreport_text() {
    local iddir="$1"; shift
    local -a big=("$@")
    echo "headlong bug report bundle"
    echo "generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "identity: $NAME"
    echo "identity dir: $iddir"
    echo "state home: $SHELLM_HOME"
    echo "app dir: $APP_DIR"
    echo
    echo "== versions"
    echo "headlong commit: $(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null || echo '(not a git checkout)')"
    echo "headlong branch: $(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    local dirty; dirty=$(git -C "$APP_DIR" status --short 2>/dev/null | wc -l | tr -d ' ')
    echo "local edits in checkout: ${dirty:-?} file(s)"
    echo "os: $(uname -srm 2>/dev/null)"
    echo "bash: $BASH_VERSION   shell: ${SHELL:-?}"
    echo "install prefix on PATH: $(command -v persona 2>/dev/null || echo '(persona not on PATH)')"
    local t; for t in jq curl uv docker cargo python3 git; do
        if command -v "$t" >/dev/null 2>&1; then
            printf '%s: %s\n' "$t" "$("$t" --version 2>&1 | head -1)"
        else
            printf '%s: missing\n' "$t"
        fi
    done
    echo
    echo "== model / env (values hidden)"
    echo "SHELLM_MODEL=${SHELLM_MODEL:-(unset)}"
    echo "SHELLM_ENV=${SHELLM_ENV:-(unset)}"
    local e; for e in "$SHELLM_HOME/.env" "$APP_DIR/.env"; do
        [[ -f "$e" ]] || continue
        echo "-- $e"
        sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\2=<hidden>/p' "$e"
    done
    echo
    echo "== status"
    ( cmd_status ) 2>&1 || true
    echo
    echo "== identity files"
    cat "$iddir/info.txt" 2>/dev/null || true
    echo
    (cd "$iddir" && du -sh -- * 2>/dev/null) || true
    echo
    echo "== trajectories"
    local tj; for tj in "$iddir"/trajectories/*/trajectory.jsonl; do
        [[ -f "$tj" ]] || continue
        printf '%s: %s rows, %s\n' "${tj#"$iddir"/}" "$(wc -l <"$tj" | tr -d ' ')" "$(du -h "$tj" | cut -f1)"
    done
    if [[ "${#big[@]}" -gt 0 ]]; then
        echo
        echo "== left out (over 50MB)"
        printf '%s\n' "${big[@]}"
    fi
    [[ "${BUGREPORT_INCLUDE_WORKDIR:-0}" -eq 1 ]] || { echo; echo "== left out: workdir/ (pass --include-workdir to add it)"; }
    echo
    echo "== disk"
    df -h "$SHELLM_HOME" 2>/dev/null | tail -1 || true
    echo
    echo "== recent thinker log tails"
    local lg; for lg in "$iddir"/run/logs/*.log; do
        [[ -f "$lg" ]] || continue
        echo "-- ${lg#"$iddir"/} (last 30 lines)"
        tail -30 "$lg" 2>/dev/null
    done
}

# _redact_tree DIR — in-place scrub of every text file under DIR. Three
# passes, in order: literal credential values, `--var NAME=VALUE`, sk- keys.
# API keys and tokens keep their first and last 4 characters
# (`<redacted sk-o...cdef>`) so two keys can be told apart; passwords and
# anything under 20 characters are masked whole.
_redact_tree() {
    local root="$1"
    local -a pairs=() files=()   # pairs: "value<TAB>replacement"
    # Literal values: credential-looking names from the env files and the
    # current environment (the env files were loaded into it at startup).
    local n v e
    for e in "$SHELLM_HOME/.env" "$APP_DIR/.env"; do
        [[ -f "$e" ]] || continue
        while IFS= read -r n; do
            [[ -n "$n" ]] || continue
            _is_secret_name "$n" || continue
            # shellcheck disable=SC1090
            v=$(set -a; . "$e" 2>/dev/null; printf '%s' "${!n}") || continue
            [[ "${#v}" -ge 8 ]] && pairs+=("$v	$(_redact_hint "$n" "$v")")
        done < <(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\2/p' "$e")
    done
    while IFS= read -r n; do
        _is_secret_name "$n" || continue
        v="${!n:-}"
        [[ "${#v}" -ge 8 ]] && pairs+=("$v	$(_redact_hint "$n" "$v")")
    done < <(compgen -e)
    # Text files only (tar'd dirs can carry binaries in blobs/).
    while IFS= read -r -d '' f; do files+=("$f"); done \
        < <(find "$root" -type f \( -name '*.jsonl' -o -name '*.json' -o -name '*.log' \
                -o -name '*.txt' -o -name '*.md' -o -name '*.sh' -o -name '*.yaml' -o -name '*.yml' \
                -o -name '*.toml' -o -name '*.env' -o -name '*.cfg' -o -name '*.ini' \) -print0 2>/dev/null)
    [[ "${#files[@]}" -gt 0 ]] || return 0
    # One sed script for everything, ERE (`sed -E` is in both BSD and GNU sed;
    # BSD sed has no usable BRE alternation). Write via temp file because
    # `sed -i` differs between the two.
    local script="" pr
    for pr in "${pairs[@]+"${pairs[@]}"}"; do
        script+="s/$(_sed_escape "${pr%%	*}")/$(_sed_escape "${pr#*	}")/g;"
    done
    # --var NAME=VALUE: KEY/TOKEN names keep a 4+4 hint when long enough,
    # other credential names are masked whole.
    # (a value starting with "<" is one an earlier pass already replaced)
    script+='s/--var ([A-Za-z_]*(KEY|TOKEN)[A-Za-z0-9_]*)=([^ "<\\][^ "\\]{3})[^ "\\]{12,}([^ "\\]{4})/--var \1=<redacted \3...\4>/g;'
    script+='s/--var ([A-Za-z_]*(KEY|TOKEN|SECRET|PASSW|CREDENTIAL)[A-Za-z0-9_]*)=[^ "<\\][^ "\\]*/--var \1=<redacted>/g;'
    script+='s/sk-([A-Za-z0-9_-]{4})[A-Za-z0-9_-]{12,}([A-Za-z0-9_-]{4})/<redacted sk-\1...\2>/g;'
    script+='s/sk-[A-Za-z0-9_-]{8,}/<redacted sk-...>/g;'
    local f tmp
    for f in "${files[@]}"; do
        tmp="$f.redact.$$"
        if sed -E "$script" "$f" > "$tmp" 2>/dev/null; then
            mv -f "$tmp" "$f"
        else
            rm -f "$tmp"
        fi
    done
}

# _redact_hint NAME VALUE — the replacement for VALUE: first/last 4 chars for
# keys and tokens of 20+ chars, a plain <redacted> otherwise.
_redact_hint() {
    local u="${1^^}" v="$2"
    if [[ "$u" =~ (KEY|TOKEN) && ! "$u" =~ (SECRET|PASSW|CREDENTIAL) && "${#v}" -ge 20 ]]; then
        printf '<redacted %s...%s>' "${v:0:4}" "${v: -4}"
    else
        printf '<redacted>'
    fi
}

_is_secret_name() {  # same notion as shellm's trajectory masking
    local u="${1^^}"
    [[ "$u" =~ (KEY|TOKEN|SECRET|PASSW|CREDENTIAL) ]]
}

_sed_escape() {  # escape a literal for use in an ERE sed s/// pattern or replacement
    printf '%s' "$1" | sed -e 's/[][\/.*^$&+?(){}|\\]/\\&/g'
}

usage() {
    cat <<EOF
$CMD — talk to and manage the identity '$NAME'

Usage:
  $CMD                 chat with them
  $CMD <message>       send one message and wait briefly for the reply
  $CMD say <message>   the same, explicitly (for messages starting with a
                       word like 'stop' or 'status')
  $CMD start           resume their mind (and the dash)
  $CMD stop            pause their mind and stop the dash
  $CMD status          mind + dash status
  $CMD dash            start the dashboard if needed and open it
  $CMD shell           subshell with their environment (advanced)
  $CMD bugreport       bundle logs + trajectory (secrets scrubbed) into one
                       .tgz to attach to a bug report
EOF
}

case "${1:-}" in
    "")          cmd_chat ;;
    say)         shift; cmd_say "$@" ;;
    start)       cmd_start ;;
    stop)        cmd_stop ;;
    status)      cmd_status ;;
    dash)        cmd_dash ;;
    shell)       cmd_shell ;;
    bugreport)   shift; cmd_bugreport "$@" ;;
    -h|--help|help) usage ;;
    -*)          die "unknown option: $1 (try: $CMD --help)" ;;
    *)           cmd_say "$@" ;;   # `ada hello there` just talks to them
esac
