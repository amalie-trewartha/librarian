#!/usr/bin/env bash
# bin/librarian-env — source this; it is not a command.
#
# Librarian names are canonical; the Headlong spellings the framework used
# until 2026-10 keep working (design/rename-to-librarian.md). Every entry
# script sources this before reading its settings, so a box or shell still
# exporting HEADLONG_* behaves as if it had exported LIBRARIAN_*.
#
#   LIBRARIAN_X        <- HEADLONG_X when LIBRARIAN_X is unset
#   LIBRARIAN_MEMORY   <- HEADLONG_LIBRARIAN      (the memory system's on/off switch)
#   LIBRARIAN_SRC      <- HEADLONG_LIBRARIAN_SRC  (the memory package path)
#   LIBRARIAN_HOME     defaults to ~/.headlong when it exists and ~/.librarian does not
#   LIBRARIAN_THINKERS_TEMPLATES likewise prefers an existing ~/.headlong-thinkers
#
# bash 3.2 and `set -u` safe; sourcing it twice is harmless.
if [[ -z "${LIBRARIAN_MEMORY+x}" && -n "${HEADLONG_LIBRARIAN+x}" ]]; then export LIBRARIAN_MEMORY="$HEADLONG_LIBRARIAN"; fi
if [[ -z "${LIBRARIAN_SRC+x}" && -n "${HEADLONG_LIBRARIAN_SRC+x}" ]]; then export LIBRARIAN_SRC="$HEADLONG_LIBRARIAN_SRC"; fi
for _le_hv in $(compgen -A variable HEADLONG_ 2>/dev/null); do
    case "$_le_hv" in HEADLONG_LIBRARIAN|HEADLONG_LIBRARIAN_SRC) continue ;; esac
    _le_lv="LIBRARIAN_${_le_hv#HEADLONG_}"
    if [[ -z "${!_le_lv+x}" ]]; then export "$_le_lv=${!_le_hv}"; fi
done
unset _le_hv _le_lv
if [[ -z "${LIBRARIAN_HOME:-}" && -n "${HOME:-}" && ! -d "$HOME/.librarian" && -d "$HOME/.headlong" ]]; then
    export LIBRARIAN_HOME="$HOME/.headlong"
fi
if [[ -z "${LIBRARIAN_THINKERS_TEMPLATES:-}" && -n "${HOME:-}" ]]; then
    if [[ ! -d "$HOME/.librarian-thinkers" && -d "$HOME/.headlong-thinkers" ]]; then
        export LIBRARIAN_THINKERS_TEMPLATES="$HOME/.headlong-thinkers"
    fi
fi
