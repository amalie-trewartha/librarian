#!/usr/bin/env bash
set -euo pipefail

# shellm-telegram-bridge — Telegram Bot API bridge for a shellm identity.
#
# Usage:
#   shellm-telegram-bridge [ROOT] [--verbose]
#
# ROOT defaults to the shellm repo (parent of this script's directory).
# Requires uv. Configuration via env: TELEGRAM_BOT_TOKEN, TELEGRAM_ADMIN_ID,
# SHELLM_TELEGRAM_IDENTITY (default audel), SHELLM_WEB_URL.
#
# Note: the production systemd unit does NOT use this script — it execs the
# project venv directly so the bridge can run as its own user (uv would try
# to write the shellm-owned venv). This launcher is for local dev.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

command -v uv >/dev/null 2>&1 || { echo "shellm-telegram-bridge: uv is required (https://docs.astral.sh/uv/)" >&2; exit 1; }

# First arg is ROOT if it isn't a flag; all remaining args pass through.
if [[ $# -gt 0 && "${1:0:1}" != "-" ]]; then
    serve_root="$1"
    shift
else
    serve_root="$ROOT_DIR"
fi

exec uv run --project "$ROOT_DIR/telegram" shellm-telegram-bridge "$serve_root" "$@"
