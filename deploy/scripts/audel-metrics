#!/usr/bin/env bash
# deploy/scripts/audel-metrics — reply-latency and run-shape metrics for Audel.
#
# Usage: deploy/scripts/audel-metrics [--cached] [--json]
#
# Computes, from the box's mind log: reply latency split by reply path (fast
# path vs inside a run) and by whether the message arrived while a run was in
# progress, run lengths, duplicate-reply counts, and a per-day usage series
# (messages in/out, model calls, tokens in/out/thinking, runs, steps) plus
# token totals per model — the "how is usage evolving" view. Tokens come from
# the identity's llm usage ledger (usage/llm.jsonl, every bin/llm call) on the
# days it covers, and from the tokens bin/shellm stamps on reasoning steps
# (shellm runs only) on days before the ledger existed. Aggregates on the box
# (SSM output is capped at 24KB), caches the data in .metrics/, keeps a dated
# JSON snapshot next to the cache, and prints a plain-text report. Run it
# before a change to freeze a baseline, and again after to compare.
#
# --cached   re-render from the last pull, no AWS calls
# --json     print the raw JSON instead of the report
# --html     also render an HTML chart page (reply-latency ECDFs) and open it
#
# Identity defaults to audel; override with SHELLM_METRICS_IDENTITY.

export SHELLM_TF_STACK="${SHELLM_TF_STACK:-terraform-slack}"
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

IDENT="${SHELLM_METRICS_IDENTITY:-audel}"
OUT_DIR="$REPO_ROOT/.metrics"
DATA="$OUT_DIR/$IDENT-metrics.json"

cached=0 raw_json=0 html=0
for arg in "$@"; do
    case "$arg" in
        --cached)  cached=1 ;;
        --json)    raw_json=1 ;;
        --html)    html=1 ;;
        -h|--help) sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown flag: $arg (see --help)" ;;
    esac
done

require_tools python3
mkdir -p "$OUT_DIR"

if [[ "$cached" -eq 0 ]]; then
    require_tools terraform aws jq
    require_state
    require_aws

    # The box-side extractor: one pass over the identity's root trajectory.
    # Everything is aggregated here because the payload has to fit the 24KB
    # SSM cap. What it computes:
    #   - one record per inbound message: reply latency, which path replied
    #     (fast = no run_id on the reply, in-run = run_id present), whether
    #     the message arrived inside a run's span, whether a dispatcher
    #     feedback marker exists for it (the mid-run injection change; zero
    #     before that change ships), and how many stamped replies it got.
    #   - run shapes: iterations (reasoning steps per run_id) and wall clock,
    #     as percentiles. A run's span ends at its final step when one
    #     exists — steps appended later with an inherited run_id are Audel's
    #     background processes, not the run.
    #   - llm_s/exec_s duration percentiles, once bin/shellm stamps them.
#   - per UTC day: messages in/out, model calls, tokens in/out/thinking,
#     runs started, reasoning steps, log rows; token totals per model.
#     Calls/tokens per day come from the llm ledger when it has at least
#     as many calls as the stamps that day (a complete ledger is a superset;
#     model on each line), else from the reasoning-step stamps (model taken
#     from the run's shellm-run row via run_id). Same rule as
#     web/src/headlong_web/usage.py.
    onbox_script="IDENT_DIR=/opt/shellm/app/.identities/$IDENT
$(cat <<'ONBOX'
set -euo pipefail
[ -d "$IDENT_DIR" ] || { echo "no identity dir on box: $IDENT_DIR" >&2; exit 1; }
python3 - "$IDENT_DIR" <<'PYEOF'
import base64, bisect, glob, gzip, json, os, re, sys
from datetime import datetime, timezone

ident_dir = sys.argv[1]
ident = os.path.basename(ident_dir.rstrip("/"))

def log_path():
    try:
        with open(os.path.join(ident_dir, "info.txt"), encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("root_trajectory="):
                    root = line.split("=", 1)[1].strip()
                    hits = glob.glob(os.path.join(ident_dir, "trajectories", root[:8] + "-*", "trajectory.jsonl"))
                    if hits:
                        return hits[0]
    except OSError:
        pass
    hits = sorted(glob.glob(os.path.join(ident_dir, "trajectories", "*-root", "trajectory.jsonl")))
    return hits[0] if hits else None

path = log_path()
if not path:
    sys.stderr.write("no root trajectory found under " + ident_dir + "\n")
    sys.exit(1)

OFFSET_FIX = re.compile(r"([+-][0-9]{2})([0-9]{2})$")

def epoch(ts):
    ts = ts.strip()
    if ts.endswith("Z"):
        ts = ts[:-1] + "+00:00"
    ts = OFFSET_FIX.sub(r"\1:\2", ts)
    dt = datetime.fromisoformat(ts)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.timestamp()

def pct(values):
    if not values:
        return None
    vs = sorted(values)
    def at(p):
        return round(vs[int(round(p / 100.0 * (len(vs) - 1)))], 1)
    return {"n": len(vs), "p50": at(50), "p90": at(90), "p95": at(95), "max": round(vs[-1], 1)}

inbound = []            # (step_id, ts, sender)
outgoing = []           # (ts, to, reply_to, in_run)
runs = {}               # run_id -> [first_ts, last_ts, final_ts, n_reasoning]
fb_marked = set()       # inbound step_ids with a dispatcher feedback marker
fb_events = []          # (trigger_step_id, feedback_ts)
run_appends = []        # ts of every reasoning/shell-output append (for
                        # locating the iteration boundary after an injection)
llm_s, exec_s = [], []
in_tok, out_tok, think_tok = [], [], []
run_model = {}          # run_id -> model (from the shellm-run row)
daily = {}              # "YYYY-MM-DD" -> counters (calls/tokens = stamps)
day_models = {}         # "YYYY-MM-DD" -> model -> {calls, in, out, think} (stamps)
ledger_daily = {}       # "YYYY-MM-DD" -> {calls, in, out, think, models}
skipped = 0
total = 0
ledger_rows = 0

DAY_KEYS = ("rows", "in_msg", "out_msg", "runs", "reasoning", "calls", "in", "out", "think")
TOK = ("calls", "in", "out", "think")

def day_key(ts):
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%d")

def day_of(ts):
    return daily.setdefault(day_key(ts), dict.fromkeys(DAY_KEYS, 0))

with open(path, encoding="utf-8", errors="replace") as fh:
    for line in fh:
        line = line.strip()
        if not line:
            continue
        total += 1
        try:
            step = json.loads(line)
        except ValueError:
            skipped += 1
            continue
        t = step.get("type") or ""
        try:
            ts = epoch(step.get("ts") or "")
        except (ValueError, TypeError):
            skipped += 1
            continue
        rid = step.get("run_id") or ""
        dd = day_of(ts)
        dd["rows"] += 1
        if t == "shellm-run":
            dd["runs"] += 1
            # the run's step_id is the run_id its reasoning/final steps carry
            if step.get("step_id"):
                run_model[step["step_id"]] = str(step.get("model") or "?")
        if rid and t not in ("shellm-run", "trajectory"):
            r = runs.setdefault(rid, [ts, ts, None, 0])
            r[0] = min(r[0], ts)
            r[1] = max(r[1], ts)
            if t == "final" and r[2] is None:
                r[2] = ts
            elif t == "reasoning":
                r[3] += 1
        if t == "message":
            frm, to = step.get("from") or "", step.get("to") or ""
            if to == ident and frm and frm != ident:
                inbound.append((step.get("step_id") or "", ts, frm))
                dd["in_msg"] += 1
            elif frm == ident and to and to != ident:
                outgoing.append((ts, to, step.get("reply_to") or "", bool(rid)))
                dd["out_msg"] += 1
        elif t == "feedback" and step.get("source") == "dispatcher" and step.get("trigger_step"):
            fb_marked.add(step["trigger_step"])
            fb_events.append((step["trigger_step"], ts))
        elif t in ("reasoning", "shell-output"):
            if rid:
                run_appends.append(ts)
            if t == "reasoning":
                dd["reasoning"] += 1
                if isinstance(step.get("llm_s"), (int, float)):
                    llm_s.append(step["llm_s"])
                bm = day_models.setdefault(day_key(ts), {}).setdefault(run_model.get(rid, "?"), dict.fromkeys(TOK, 0))
                stamped = False
                for key, dest, short in (("in_tok", in_tok, "in"), ("out_tok", out_tok, "out"), ("think_tok", think_tok, "think")):
                    if isinstance(step.get(key), (int, float)):
                        dest.append(step[key])
                        dd[short] += int(step[key])
                        bm[short] += int(step[key])
                        stamped = True
                if stamped:
                    dd["calls"] += 1
                    bm["calls"] += 1
            elif isinstance(step.get("exec_s"), (int, float)):
                exec_s.append(step["exec_s"])

# The llm usage ledger: one line per successful bin/llm call from any caller
# (shellm runs, the responder fast path, other thinkers). Appended by bin/llm
# unconditionally, so it is the complete spend on the days it covers.
ledger_path = os.path.join(ident_dir, "usage", "llm.jsonl")
try:
    with open(ledger_path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            ledger_rows += 1
            try:
                rec = json.loads(line)
                lts = epoch(rec.get("ts") or "")
            except (ValueError, TypeError, AttributeError):
                continue
            ld = ledger_daily.setdefault(day_key(lts), dict.fromkeys(TOK, 0))
            lm = ld.setdefault("models", {}).setdefault(str(rec.get("model") or "?"), dict.fromkeys(TOK, 0))
            stamped = False
            for key, short in (("in_tok", "in"), ("out_tok", "out"), ("think_tok", "think")):
                if isinstance(rec.get(key), (int, float)):
                    ld[short] += int(rec[key])
                    lm[short] += int(rec[key])
                    stamped = True
            if stamped:
                ld["calls"] += 1
                lm["calls"] += 1
except OSError:
    pass

# Per day, the ledger wins when it has at least as many calls as the stamps
# (a complete ledger is a superset of them); otherwise the stamps stand (days
# before the ledger existed, the part-day it started on). by_model sums the
# winning source per day.
by_model = {}
ledger_since = None
for d in sorted(set(daily) | set(ledger_daily)):
    dd = daily.setdefault(d, dict.fromkeys(DAY_KEYS, 0))
    ld = ledger_daily.get(d)
    if ld and ld["calls"] > 0 and ld["calls"] >= dd["calls"]:
        for k in TOK:
            dd[k] = ld[k]
        dd["source"] = "ledger"
        models = ld["models"]
        if ledger_since is None:
            ledger_since = d
    else:
        dd["source"] = "mindlog"
        models = day_models.get(d, {})
    for m, v in models.items():
        bm = by_model.setdefault(m, dict.fromkeys(TOK, 0))
        for k in TOK:
            bm[k] += v[k]

# Run spans for busy-at-arrival, sorted for bisect. End at the final step
# when the run has one, else at the last step seen with that run_id.
spans = sorted((r[0], (r[2] if r[2] is not None else r[1])) for r in runs.values())
starts = [s[0] for s in spans]

def busy_at(ts):
    i = bisect.bisect_right(starts, ts)
    return any(spans[j][1] >= ts for j in range(max(0, i - 3), i))

outgoing.sort()
by_reply_to = {}
for o in outgoing:
    if o[2]:
        by_reply_to.setdefault(o[2], []).append(o)

records = []            # [latency_s|None, path, busy, marked, pairing, n_stamped]
for sid, ts, sender in inbound:
    stamped = by_reply_to.get(sid, [])
    reply, pairing = None, "none"
    if stamped:
        reply, pairing = stamped[0], "stamped"
    else:
        for o in outgoing:
            if o[0] > ts and o[1] == sender and not o[2]:
                reply, pairing = o, "positional"
                break
    lat = round(reply[0] - ts, 1) if reply and reply[0] >= ts else None
    p = ("in_run" if reply[3] else "fast") if reply else ""
    records.append([lat, p, busy_at(ts), sid in fb_marked, pairing, len(stamped)])

out_counts = {
    "reply_fast": sum(1 for o in outgoing if o[2] and not o[3]),
    "reply_in_run": sum(1 for o in outgoing if o[2] and o[3]),
    "other_in_run": sum(1 for o in outgoing if not o[2] and o[3]),
    "other_fast": sum(1 for o in outgoing if not o[2] and not o[3]),
}

# Injection events: decompose each mid-run reply chain. The boundary is the
# first run append (reasoning/shell-output) after the feedback — the moment
# the in-flight model call + command finished and the note became visible.
run_appends.sort()
by_id = {i: (t, s) for (i, t, s) in inbound}
injections = []
for trig, fb_ts in fb_events:
    if trig not in by_id:
        continue
    msg_ts = by_id[trig][0]
    reply = next((o for o in outgoing if o[2] == trig), None)
    j = bisect.bisect_right(run_appends, fb_ts)
    bnd = run_appends[j] if j < len(run_appends) else None
    ev = {
        "when": datetime.fromtimestamp(msg_ts, timezone.utc).strftime("%m-%d %H:%M"),
        "inject_ms": int(round((fb_ts - msg_ts) * 1000)),
        "wait_s": None, "model_s": None, "total_s": None, "path": "none",
    }
    if reply:
        r_ts, in_run = reply[0], reply[3]
        ev["total_s"] = round(r_ts - msg_ts, 1)
        ev["path"] = "inline" if in_run else "fast"
        if in_run and bnd is not None and bnd <= r_ts:
            ev["wait_s"] = round(bnd - fb_ts, 1)
            ev["model_s"] = round(r_ts - bnd, 1)
    injections.append(ev)
real_runs = [r for r in runs.values() if r[3] > 0]
out = {
    "identity": ident,
    "log": path,
    "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "log_lines": total,
    "skipped": skipped,
    "inbound": len(inbound),
    "outgoing": out_counts,
    "records": records,
    "runs": {
        "count": len(real_runs),
        "iterations": pct([r[3] for r in real_runs]),
        "wall_s": pct([(r[2] if r[2] is not None else r[1]) - r[0] for r in real_runs]),
    },
    "durations": {"llm_s": pct(llm_s), "exec_s": pct(exec_s)},
    "tokens": {
        "in_tok": pct(in_tok), "out_tok": pct(out_tok), "think_tok": pct(think_tok),
        "totals": {"in": sum(in_tok), "out": sum(out_tok), "think": sum(think_tok)},
    },
    "injections": injections,
    "daily": [[d, daily[d]] for d in sorted(daily)],
    "by_model": by_model,
    "ledger": {"rows": ledger_rows, "since": ledger_since},
}
blob = base64.b64encode(gzip.compress(json.dumps(out, separators=(",", ":")).encode())).decode()
if len(blob) > 23000:
    sys.stderr.write("warning: payload " + str(len(blob)) + "B is near the 24KB SSM cap\n")
print("AUDEL_METRICS_BEGIN")
for i in range(0, len(blob), 76):
    print(blob[i : i + 76])
print("AUDEL_METRICS_END")
PYEOF
ONBOX
)"

    info "pulling $IDENT metrics from the box ($SHELLM_TF_STACK)..."
    payload=$(run_script_on_box "$onbox_script")
    b64=$(awk '/^AUDEL_METRICS_BEGIN$/{f=1;next} /^AUDEL_METRICS_END$/{f=0} f' <<<"$payload")
    [[ -n "$b64" ]] || die "no data in box output:
$payload"
    printf '%s' "$b64" | base64 -d | gunzip > "$DATA" || die "payload decode failed"
    snapshot="$OUT_DIR/$IDENT-metrics-$(date -u +%Y%m%d).json"
    cp "$DATA" "$snapshot"
    info "cached $(wc -c < "$DATA" | tr -d ' ') bytes -> $DATA (snapshot: $snapshot)"
else
    [[ -f "$DATA" ]] || die "no cached data at $DATA — run once without --cached"
fi

if [[ "$raw_json" -eq 1 ]]; then
    python3 -m json.tool "$DATA"
    exit 0
fi

if [[ "$html" -eq 1 ]]; then
    HTML="$OUT_DIR/$IDENT-metrics.html"
    python3 "$SCRIPTS_DIR/audel-metrics-render.py" "$DATA" "$HTML"
    command -v open >/dev/null 2>&1 && open "$HTML"
fi

python3 - "$DATA" <<'PYEOF'
import json, sys

d = json.load(open(sys.argv[1]))
recs = d["records"]

def pct(values):
    if not values:
        return None
    vs = sorted(values)
    def at(p):
        return vs[int(round(p / 100.0 * (len(vs) - 1)))]
    return {"n": len(vs), "p50": at(50), "p90": at(90), "p95": at(95), "max": vs[-1]}

def fmt(label, stats):
    if not stats:
        return "  %-28s %5d" % (label, 0)
    return "  %-28s %5d  %7.1f %7.1f %7.1f %8.1f" % (
        label, stats["n"], stats["p50"], stats["p90"], stats["p95"], stats["max"])

def seg(pred):
    return pct([r[0] for r in recs if r[0] is not None and r[4] == "stamped" and pred(r)])

o = d["outgoing"]
print("audel metrics report")
print("identity: %s   generated: %s" % (d["identity"], d["generated"]))
print("log: %s (%d lines, %d skipped)" % (d["log"], d["log_lines"], d["skipped"]))
print()
print("messages")
print("  inbound: %d" % d["inbound"])
print("  outgoing: %d (fast replies %d, in-run replies %d, in-run other %d, other %d)"
      % (sum(o.values()), o["reply_fast"], o["reply_in_run"], o["other_in_run"], o["other_fast"]))
print()
n_stamped = sum(1 for r in recs if r[4] == "stamped")
n_pos = sum(1 for r in recs if r[4] == "positional")
n_none = sum(1 for r in recs if r[4] == "none")
n_dup = sum(1 for r in recs if r[5] >= 2)
print("reply pairing (per inbound message)")
print("  stamped reply: %d   positional only: %d   unanswered: %d" % (n_stamped, n_pos, n_none))
print("  inbound with 2+ stamped replies (duplicates): %d" % n_dup)
print()
print("reply latency, stamped pairs only, seconds")
print("  %-28s %5s  %7s %7s %7s %8s" % ("segment", "n", "p50", "p90", "p95", "max"))
print(fmt("all", seg(lambda r: True)))
print(fmt("fast path", seg(lambda r: r[1] == "fast")))
print(fmt("in-run reply", seg(lambda r: r[1] == "in_run")))
print(fmt("arrived while idle", seg(lambda r: not r[2])))
print(fmt("arrived during a run", seg(lambda r: r[2])))
print(fmt("dispatcher marker present", seg(lambda r: r[3])))
print("  (dispatcher marker = mid-run injection feedback; 0 before that change ships)")
print()
r = d["runs"]
print("runs (run_id groups with at least one reasoning step)")
print("  %-28s %5s  %7s %7s %7s %8s" % ("", "n", "p50", "p90", "p95", "max"))
print(fmt("iterations per run", r["iterations"]))
print(fmt("wall clock seconds", r["wall_s"]))
print()
du = d["durations"]
if du["llm_s"] or du["exec_s"]:
    print("iteration durations, seconds (stamped by bin/shellm)")
    print(fmt("llm call (llm_s)", du["llm_s"]))
    print(fmt("bash execution (exec_s)", du["exec_s"]))
else:
    print("iteration durations: not stamped yet (llm_s/exec_s not in this log)")

tk = d.get("tokens") or {}
if tk.get("in_tok") or tk.get("out_tok"):
    print()
    print("tokens per model call (stamped by bin/llm)")
    print("  %-28s %5s  %7s %7s %7s %8s" % ("", "n", "p50", "p90", "p95", "max"))
    print(fmt("input (in_tok)", tk.get("in_tok")))
    print(fmt("output (out_tok)", tk.get("out_tok")))
    print(fmt("thinking (think_tok)", tk.get("think_tok")))
    tot = tk.get("totals") or {}
    print("  totals: in %s  out %s  thinking %s"
          % tuple("{:,}".format(int(tot.get(k, 0))) for k in ("in", "out", "think")))

led = d.get("ledger") or {}
bym = d.get("by_model") or {}
if bym:
    print()
    if led.get("since"):
        print("tokens per model (llm ledger, every call, from %s; shellm-run stamps only before)" % led["since"])
    else:
        print("tokens per model (shellm-run stamps only; llm ledger has no calls yet)")
    print("  %-32s %6s %13s %12s %12s" % ("model", "calls", "in", "out", "thinking"))
    for m, v in sorted(bym.items(), key=lambda kv: -kv[1]["in"]):
        print("  %-32s %6d %13s %12s %12s" % (m[:32], v["calls"],
              "{:,}".format(v["in"]), "{:,}".format(v["out"]), "{:,}".format(v["think"])))

daily = d.get("daily") or []
if daily:
    print()
    print("per day (utc)")
    print("  %-10s %5s %5s %5s %6s %7s %11s %10s %10s" % (
        "day", "in", "out", "runs", "steps", "calls", "tok_in", "tok_out", "tok_think"))
    for day, v in daily:
        print("  %-10s %5d %5d %5d %6d %7d %11s %10s %10s" % (
            day, v["in_msg"], v["out_msg"], v["runs"], v["reasoning"], v["calls"],
            "{:,}".format(v["in"]), "{:,}".format(v["out"]), "{:,}".format(v["think"])))
    print("  (in/out = messages; steps = reasoning steps; calls/tok = every llm call on ledger days%s,"
          % (" (from %s)" % led["since"] if led.get("since") else ""))
    print("   shellm-run stamps only on earlier days)")

inj = d.get("injections")
print()
print("injection events (message queued behind a busy run)")
if not inj:
    print("  none recorded")
else:
    print("  %-12s %-7s %8s %10s %8s %8s" % ("when (utc)", "path", "total_s", "inject_ms", "wait_s", "model_s"))
    for e in inj:
        print("  %-12s %-7s %8s %10s %8s %8s" % (
            e["when"], e["path"],
            e["total_s"] if e["total_s"] is not None else "-",
            e["inject_ms"],
            e["wait_s"] if e["wait_s"] is not None else "-",
            e["model_s"] if e["model_s"] is not None else "-"))
    print("  (inject = dispatcher wrote the note; wait = in-flight call finishing;")
    print("   model = the call that composed the reply. fast path = replied after run end)")
PYEOF
