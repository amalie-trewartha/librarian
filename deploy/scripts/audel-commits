#!/usr/bin/env bash
# deploy/scripts/audel-commits — review the agent's box commits one at a time.
#
# Usage: deploy/scripts/audel-commits list
#        deploy/scripts/audel-commits triage
#        deploy/scripts/audel-commits pull [sha]
#        deploy/scripts/audel-commits pull --tier green [--stop-on-conflict]
#        deploy/scripts/audel-commits reject <sha> [reason...]
#        deploy/scripts/audel-commits reconcile [-y]
#
# list       show box commits not on origin/main, oldest first, with
#            dispositions (pending / pulled / applied / rejected / excluded)
# triage     classify unmerged commits by the paths they touch (paths are the
#            authority — commit messages are never consulted):
#              green     docs, notes, and improve/ work — safe to batch-pull
#              yellow    new self-contained components + tests — Claude reviews
#              red       edits to shipped code (bin/, web/, slack/src/, core
#                        thinkers, protected files) — Nick reviews
#              excluded  private paths: identity/memory files, correspondence
#                        (drafts/memos/team notes), eval internals — never
#                        pulled (auto-recorded; this repo is public)
#            A commit's tier is the worst tier of any file in it.
# pull       apply one commit's diff to the local working tree UNSTAGED for
#            review; default is the oldest pending commit. Saves the commit
#            message (+ Co-authored-by trailer) to .git/AUDEL_MSG and prints
#            the commands to stage and commit. Identity files are always
#            stripped from the diff.
#            --tier green: batch mode — pull every pending green commit,
#            oldest first, committing each with its original message and
#            co-author trailer. Commits that no longer apply are left pending
#            and listed at the end (--stop-on-conflict halts at the first).
# reject     record a commit as rejected without applying it
# reconcile  after pushing accepted commits: rebase the box onto origin/main
#            (drops commits whose patch is already upstream, keeps the rest)
#
# SHAs never match across the two repos (commits are re-authored locally), so
# "already applied" is detected by git patch-id; amended or rejected commits
# are tracked in .audel-pulled (repo root, untracked — the review log).

export SHELLM_TF_STACK="${SHELLM_TF_STACK:-terraform-slack}"
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

BOX_REPO=/opt/shellm/app
STATE_FILE="$REPO_ROOT/.audel-pulled"
GIT_DIR="$(git -C "$REPO_ROOT" rev-parse --absolute-git-dir)"

# Private paths never leave the box (this repo is PUBLIC): identity/memory
# files, correspondence (drafts, memos, team notes), and eval internals
# (benchmark answers/verifier details). Stripped from every pull; a commit
# containing nothing else is recorded as excluded.
APPLY_EXCLUDES=(
    --exclude='identities/*' --exclude='.identities/*'
    --exclude='chat/drafts/*' --exclude='chat/archive/*'
    --exclude='notes-for-team.md'
    --exclude='improve/draft-to-*'
    --exclude='improve/notes/strategic_*'
    --exclude='improve/notes/tbench2_*'
    --exclude='terminal_bench2_eval/*'
)

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; exit "${1:-0}"; }

# One round trip: the box's unmerged series (oldest first), the patch-id of
# each commit, and the working-tree status. Fetches first so origin/main is
# current after a local push.
fetch_series() {
    run_script_on_box '
        g() { sudo -u shellm git -C /opt/shellm/app "$@"; }
        g fetch --quiet origin 2>/dev/null || echo "warning: box git fetch failed — origin/main may be stale" >&2
        echo "=== LOG ==="
        g log --reverse --format="%H %s" origin/main..main
        echo "=== PATCHIDS ==="
        g format-patch --stdout origin/main..main | g patch-id --stable
        echo "=== STATUS ==="
        g status --short
    '
}

# Same round trip plus per-commit file lists. The name-only log for 100+
# commits would blow the 24KB SSM output cap, so it travels gzip+base64.
fetch_series_with_files() {
    run_script_on_box '
        g() { sudo -u shellm git -C /opt/shellm/app "$@"; }
        g fetch --quiet origin 2>/dev/null || echo "warning: box git fetch failed — origin/main may be stale" >&2
        echo "=== PATCHIDS ==="
        g format-patch --stdout origin/main..main | g patch-id --stable
        echo "=== STATUS ==="
        g status --short
        echo "=== LOGZ ==="
        g log --reverse --name-only --format="=C= %H %s" origin/main..main | gzip -9 | base64 | tr -d "\n"
        echo
    '
}

section() { awk -v s="=== $1 ===" '$0==s{f=1;next} /^=== /{f=0} f' <<<"$2"; }

decode_logz() { printf '%s' "$1" | base64 -d 2>/dev/null | gunzip 2>/dev/null || true; }

# Classify a `git log --name-only --format="=C= %H %s"` stream into
# tab-separated "sha<TAB>tier<TAB>subject<TAB>red-paths" lines, one per
# commit, order preserved. Path rules only — subjects are never consulted.
classify() {
    awk '
        function ftier(f) {
            if (f ~ /^identities\// || f ~ /^\.identities\//) return "exclude"
            if (f ~ /^(chat\/drafts|chat\/archive|terminal_bench2_eval)\//) return "exclude"   # correspondence + eval internals: private
            if (f == "notes-for-team.md") return "exclude"
            if (f ~ /^improve\/draft-to-/) return "exclude"
            if (f ~ /^improve\/notes\/(strategic_|tbench2_)/) return "exclude"
            if (f == "improve/vitals.sh") return "red"   # protected: the improve loop measurement stage
            if (f ~ /^(improve|notes|design)\//) return "green"
            if (f ~ /^thinkers\/(chat|retrieval|proprioception)\//) return "yellow"
            if (f ~ /^(lens|skills\/repo-health|skills\/check-trajectory|tests|slack\/tests)\//) return "yellow"
            return "red"   # bin/, web/, slack/src/, thinkers/_lib|monolith|actor/, everything unlisted
        }
        function rank(t) { return t == "green" ? 0 : t == "yellow" ? 1 : 2 }
        function flush() {
            if (sha == "") return
            if (tot == 0)       tier = "merge"
            else if (kept == 0) tier = "exclude"
            else                tier = best
            printf "%s\t%s\t%s\t%s\n", sha, tier, subject, hot
            sha = ""
        }
        /^=C= / {
            flush()
            sha = $2
            subject = $0; sub(/^=C= [0-9a-f]+ /, "", subject)
            best = "green"; kept = 0; tot = 0; hot = ""
            next
        }
        NF {
            tot++
            t = ftier($0)
            if (t == "exclude") next
            kept++
            if (rank(t) > rank(best)) best = t
            if (t == "red") hot = hot (hot == "" ? "" : ", ") $0
        }
        END { flush() }
    '
}

# Patch-ids of recent local commits — a box commit whose patch-id appears
# here has already been applied (possibly re-authored) on this side.
local_patch_ids() {
    git -C "$REPO_ROOT" log -p -n 300 --no-merges HEAD 2>/dev/null \
        | git patch-id --stable | awk '{print $1}'
}

state_of() { # $1 = full sha -> disposition recorded in the state file, if any
    [[ -f "$STATE_FILE" ]] || return 0
    awk -v s="$1" '$1==s{print $2; exit}' "$STATE_FILE"
}

record_state() { # $1 = sha, $2 = disposition, rest = note
    local sha="$1" disp="$2"; shift 2
    [[ -f "$STATE_FILE" ]] && grep -v "^$sha " "$STATE_FILE" > "$STATE_FILE.tmp" || : > "$STATE_FILE.tmp"
    mv "$STATE_FILE.tmp" "$STATE_FILE"
    printf '%s %s %s %s\n' "$sha" "$disp" "$(date +%F)" "$*" >> "$STATE_FILE"
}

# Resolve a user-supplied (possibly short) sha against the box series.
resolve_sha() { # $1 = prefix, $2 = box log ("sha subject" lines)
    local hit
    hit=$(awk -v p="$1" 'index($1, p) == 1 {print $1}' <<<"$2")
    [[ -n "$hit" ]] || die "'$1' does not match any unmerged box commit (see: audel-commits list)"
    [[ $(wc -l <<<"$hit") -eq 1 ]] || die "'$1' is ambiguous on the box"
    printf '%s' "$hit"
}

cmd_list() {
    require_tools jq git
    require_state; require_aws
    local series log patchids status lpids
    series=$(fetch_series)
    log=$(section LOG "$series")
    patchids=$(section PATCHIDS "$series")
    status=$(section STATUS "$series")
    if [[ -z "$log" ]]; then
        info "box is level with origin/main — nothing to review"
    else
        lpids=$(local_patch_ids)
        info "box commits not on origin/main (oldest first):"
        local n=0 default="" sha subject pid disp
        while read -r sha subject; do
            n=$((n + 1))
            pid=$(awk -v s="$sha" '$2==s{print $1}' <<<"$patchids")
            disp=$(state_of "$sha")
            if [[ -z "$pid" ]]; then
                disp=merge   # no patch-id = merge (or empty) commit — nothing to pull
            elif grep -qx "$pid" <<<"$lpids"; then
                disp=applied
            fi
            : "${disp:=pending}"
            [[ -z "$default" && "$disp" == pending ]] && default="$sha"
            printf '  %2d  %s  %-8s %s\n' "$n" "${sha:0:7}" "$disp" "$subject"
        done <<<"$log"
        if [[ -n "$default" ]]; then
            printf '\n  next pull (default): %s\n' "${default:0:7}"
        else
            printf '\n  nothing pending — all commits dispositioned\n'
        fi
    fi
    if [[ -n "$status" ]]; then
        info "box working tree is DIRTY (uncommitted agent work — reconcile stashes tracked changes):"
        sed 's/^/  /' <<<"$status"
    else
        info "box working tree clean"
    fi
}

cmd_triage() {
    require_tools jq git gzip
    require_state; require_aws
    local raw patchids status classified lpids
    raw=$(fetch_series_with_files)
    patchids=$(section PATCHIDS "$raw")
    status=$(section STATUS "$raw")
    classified=$(decode_logz "$(section LOGZ "$raw")" | classify)
    if [[ -z "$classified" ]]; then
        info "box is level with origin/main — nothing to triage"
    else
        lpids=$(local_patch_ids)
        local sha tier subject hot pid disp line
        local g_out="" y_out="" r_out="" x_out="" m_out=""
        local g_n=0 y_n=0 r_n=0 x_n=0 m_n=0
        while IFS=$'\t' read -r sha tier subject hot; do
            disp=$(state_of "$sha")
            pid=$(awk -v s="$sha" '$2==s{print $1}' <<<"$patchids")
            if [[ -n "$pid" ]] && grep -qx "$pid" <<<"$lpids"; then
                disp=applied
            fi
            if [[ "$tier" == exclude && -z "$disp" ]]; then
                record_state "$sha" excluded "private paths only"
                disp=excluded
            fi
            [[ "$tier" == merge ]] && disp=merge
            : "${disp:=pending}"
            line=$(printf '  %s  %-8s %s' "${sha:0:7}" "$disp" "$subject")
            case "$tier" in
                green)   g_out+="$line"$'\n'; g_n=$((g_n + 1)) ;;
                yellow)  y_out+="$line"$'\n'; y_n=$((y_n + 1)) ;;
                red)     r_out+="$line"$'\n'
                         if [[ -n "$hot" ]]; then
                             r_out+="               -> $hot"$'\n'
                         fi
                         r_n=$((r_n + 1)) ;;
                exclude) x_out+="$line"$'\n'; x_n=$((x_n + 1)) ;;
                merge)   m_out+="$line"$'\n'; m_n=$((m_n + 1)) ;;
            esac
        done <<<"$classified"
        info "triage of box commits not on origin/main (oldest first; a commit's tier = worst path it touches):"
        if [[ "$r_n" -gt 0 ]]; then
            printf '\nRED (%d) — edits to shipped code, Nick reviews (offending paths shown):\n%s' "$r_n" "$r_out"
        fi
        if [[ "$y_n" -gt 0 ]]; then
            printf '\nYELLOW (%d) — new self-contained components/tests, Claude reviews:\n%s' "$y_n" "$y_out"
        fi
        if [[ "$g_n" -gt 0 ]]; then
            printf '\nGREEN (%d) — docs/notes/improve, batch-pull with: audel-commits pull --tier green:\n%s' "$g_n" "$g_out"
        fi
        if [[ "$x_n" -gt 0 ]]; then
            printf '\nEXCLUDED (%d) — private paths (identity, correspondence, eval internals), never pulled:\n%s' "$x_n" "$x_out"
        fi
        if [[ "$m_n" -gt 0 ]]; then
            printf '\nMERGES (%d) — no diff of their own:\n%s' "$m_n" "$m_out"
        fi
        printf '\n'
    fi
    if [[ -n "$status" ]]; then
        info "box working tree is DIRTY (uncommitted agent work — reconcile stashes tracked changes):"
        sed 's/^/  /' <<<"$status"
    else
        info "box working tree clean"
    fi
}

# Fetch one box commit as a patch, strip identity files, and apply it locally.
# Sets PULL_RESULT (pulled|excluded) and PULL_FILES (kept paths, one per
# line); with do_commit=1 also stages the kept paths and commits with the
# prefilled message. Returns 1 if the patch can't be fetched or won't apply.
pull_one() { # $1 = full sha, $2 = do_commit (0|1)
    local sha="$1" do_commit="$2"
    local b64 patch="$GIT_DIR/AUDEL_PATCH"
    b64=$(run_script_on_box "sudo -u shellm git -C $BOX_REPO format-patch --stdout -1 $sha | gzip -9 | base64 | tr -d '\n'") || return 1
    printf '%s' "$b64" | base64 -d | gunzip > "$patch" \
        || { echo "patch retrieval failed (SSM output is capped at 24KB — is this commit huge?)" >&2; return 1; }

    local body="$GIT_DIR/AUDEL_BODY" diff="$GIT_DIR/AUDEL_DIFF" msg="$GIT_DIR/AUDEL_MSG"
    local minfo author email msubject
    minfo=$(git mailinfo "$body" "$diff" < "$patch") || return 1
    author=$(sed -n 's/^Author: //p' <<<"$minfo")
    email=$(sed -n 's/^Email: //p' <<<"$minfo")
    msubject=$(sed -n 's/^Subject: //p' <<<"$minfo")
    {
        printf '[audel] %s\n\n' "$msubject"
        if [[ -s "$body" ]]; then cat "$body"; printf '\n'; fi
        printf 'Co-authored-by: %s <%s>\n' "${author:-audel}" "${email:-audel@local}"
    } > "$msg"

    # Strip locally-gitignored paths too (e.g. improve/generations — local run
    # artifacts; the box's copies must not merge into ours).
    local f keep="" excl=("${APPLY_EXCLUDES[@]}")
    PULL_FILES=$(git -C "$REPO_ROOT" apply --numstat "${APPLY_EXCLUDES[@]}" "$diff" | cut -f3-)
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        if git -C "$REPO_ROOT" check-ignore -q -- "$f" 2>/dev/null; then
            excl+=(--exclude="$f")
        else
            keep+="$f"$'\n'
        fi
    done <<<"$PULL_FILES"
    PULL_FILES="${keep%$'\n'}"
    if [[ -z "$PULL_FILES" ]]; then
        record_state "$sha" excluded "private/ignored paths only"
        PULL_RESULT=excluded
        return 0
    fi
    PULL_RESULT=pulled
    if [[ "$do_commit" -eq 1 ]]; then
        # --index stages adds, deletions, and renames atomically; record only
        # after the commit actually exists.
        git -C "$REPO_ROOT" apply --index --check "${excl[@]}" "$diff" || return 1
        git -C "$REPO_ROOT" apply --index "${excl[@]}" "$diff" || return 1
        git -C "$REPO_ROOT" commit --quiet -F "$msg" || return 1
        record_state "$sha" pulled "$msubject"
    else
        git -C "$REPO_ROOT" apply --check "${excl[@]}" "$diff" || return 1
        git -C "$REPO_ROOT" apply "${excl[@]}" "$diff" || return 1
        record_state "$sha" pulled "$msubject"
    fi
    return 0
}

cmd_pull() {
    require_tools jq git
    require_state; require_aws
    git -C "$REPO_ROOT" diff --quiet && git -C "$REPO_ROOT" diff --cached --quiet \
        || die "local working tree has uncommitted changes — commit or stash them first (untracked files are fine)"

    local tier="" stop_on_conflict=0 target=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tier) tier="${2:-}"; [[ -n "$tier" ]] || die "--tier needs green|yellow|red"; shift 2 ;;
            --stop-on-conflict) stop_on_conflict=1; shift ;;
            *) target="$1"; shift ;;
        esac
    done
    if [[ -n "$tier" ]]; then
        [[ -z "$target" ]] || die "pull --tier does not take a sha"
        cmd_pull_batch "$tier" "$stop_on_conflict"
        return
    fi

    local series log sha subject default cur
    series=$(fetch_series)
    log=$(section LOG "$series")
    [[ -n "$log" ]] || die "box is level with origin/main — nothing to pull"

    # Default target: oldest commit that is neither dispositioned nor
    # patch-id-equivalent to something already local.
    default=""
    local lpids pid disp
    lpids=$(local_patch_ids)
    while read -r cur subject; do
        pid=$(awk -v s="$cur" '$2==s{print $1}' < <(section PATCHIDS "$series"))
        [[ -n "$pid" ]] || continue   # merge/empty commit — never a pull target
        disp=$(state_of "$cur")
        grep -qx "$pid" <<<"$lpids" && disp=applied
        [[ -z "$disp" ]] && { default="$cur"; break; }
    done <<<"$log"

    if [[ -n "$target" ]]; then
        sha=$(resolve_sha "$target" "$log")
        pid=$(awk -v s="$sha" '$2==s{print $1}' < <(section PATCHIDS "$series"))
        [[ -n "$pid" ]] || die "${sha:0:7} is a merge (or empty) commit — nothing to pull; it drops in the reconcile rebase"
        if [[ -n "$default" && "$sha" != "$default" ]]; then
            echo "warning: skipping ahead — oldest pending is ${default:0:7}; this diff may not apply cleanly" >&2
        fi
    else
        sha="$default"
        [[ -n "$sha" ]] || die "nothing pending — all box commits are dispositioned (see: audel-commits list)"
    fi
    subject=$(awk -v s="$sha" '$1==s{sub($1 FS, ""); print; exit}' <<<"$log")

    info "pulling ${sha:0:7}  $subject"
    pull_one "$sha" 0 \
        || die "patch does not apply — pull earlier pending commits first, or resolve by hand: git apply --3way $GIT_DIR/AUDEL_DIFF"
    if [[ "$PULL_RESULT" == excluded ]]; then
        info "commit touches identity files only — recorded excluded, nothing applied"
        return 0
    fi

    info "applied to working tree (unstaged):"
    sed 's/^/  /' <<<"$PULL_FILES"
    local files
    files=$(tr '\n' ' ' <<<"$PULL_FILES")
    cat <<EOF

Review, then commit (message prefilled with audel as co-author):

  git diff
  git add -- $files
  git commit -eF .git/AUDEL_MSG

To back out instead:  git checkout -- $files   (plus rm for new files)
Then record it:       deploy/scripts/audel-commits reject ${sha:0:7} <reason>
EOF
}

cmd_pull_batch() { # $1 = tier, $2 = stop_on_conflict (0|1)
    local want="$1" stop_on_conflict="$2"
    local start
    start=$(git -C "$REPO_ROOT" rev-parse --short HEAD)
    info "batch starts at local HEAD $start — undo before pushing with: git reset --hard $start (then drop the new 'pulled' lines from .audel-pulled)"
    local raw patchids classified lpids
    raw=$(fetch_series_with_files)
    patchids=$(section PATCHIDS "$raw")
    classified=$(decode_logz "$(section LOGZ "$raw")" | classify)
    [[ -n "$classified" ]] || die "box is level with origin/main — nothing to pull"
    lpids=$(local_patch_ids)

    local sha tier subject hot pid disp
    local pulled=0 skipped=0 excluded=0 conflicts=""
    while IFS=$'\t' read -r sha tier subject hot; do
        [[ "$tier" == "$want" ]] || continue
        disp=$(state_of "$sha")
        pid=$(awk -v s="$sha" '$2==s{print $1}' <<<"$patchids")
        if [[ -n "$pid" ]] && grep -qx "$pid" <<<"$lpids"; then
            disp=applied
        fi
        if [[ -n "$disp" ]]; then
            skipped=$((skipped + 1))
            continue
        fi
        info "pulling ${sha:0:7}  $subject"
        # </dev/null: the SSM call inside pull_one must not eat the loop's stdin
        if pull_one "$sha" 1 </dev/null; then
            if [[ "$PULL_RESULT" == excluded ]]; then
                excluded=$((excluded + 1))
            else
                pulled=$((pulled + 1))
            fi
        else
            conflicts="$conflicts ${sha:0:7}"
            if [[ "$stop_on_conflict" -eq 1 ]]; then
                die "stopped at ${sha:0:7} — pull it individually or resolve by hand, then re-run the batch"
            fi
            echo "  does not apply — left pending, continuing" >&2
        fi
    done <<<"$classified"

    info "batch done: $pulled committed, $skipped already dispositioned, $excluded excluded"
    if [[ -n "$conflicts" ]]; then
        info "left pending (did not apply):$conflicts — pull these individually once their prerequisite commits land"
    fi
    if [[ "$pulled" -gt 0 ]]; then
        echo "review the new commits (git log -$pulled), push, then: deploy/scripts/audel-commits reconcile"
        echo "to undo the whole batch instead: git reset --hard $start  (then drop the new 'pulled' lines from .audel-pulled)"
    fi
}

cmd_reject() {
    [[ -n "${1:-}" ]] || usage 1
    require_tools jq git
    require_state; require_aws
    local log sha
    log=$(section LOG "$(fetch_series)")
    sha=$(resolve_sha "$1" "$log"); shift
    record_state "$sha" rejected "$@"
    info "recorded ${sha:0:7} as rejected${1:+ ($*)}"
    echo "note: the box still runs this commit until you reconcile (it will survive the rebase — rewind it by hand if it must go)"
}

cmd_reconcile() {
    local yes=0
    [[ "${1:-}" == "-y" ]] && yes=1
    require_tools jq git
    require_state; require_aws

    info "checking the box against origin/main..."
    local check cherry status
    check=$(run_script_on_box '
        g() { sudo -u shellm git -C /opt/shellm/app "$@"; }
        g fetch --quiet origin
        echo "=== CHERRY ==="
        g cherry -v origin/main main
        echo "=== STATUS ==="
        g status --short
    ')
    cherry=$(section CHERRY "$check")
    status=$(section STATUS "$check")
    if [[ -z "$cherry" ]]; then
        info "box is already level with origin/main — nothing to reconcile"
        return 0
    fi
    local total drops keeps
    total=$(wc -l <<<"$cherry" | tr -d ' ')
    drops=$(grep -c '^-' <<<"$cherry" || true)
    keeps=$(grep -c '^+' <<<"$cherry" || true)
    info "box is $total commit(s) ahead of origin/main: $drops drop in the rebase (patch already upstream), $keeps survive"
    echo "  '-' = drops, '+' = survives:"
    sed 's/^/  /' <<<"$cherry"
    [[ -n "$status" ]] && { echo "  box tree is dirty — tracked and untracked changes will be stashed and re-applied:"; sed 's/^/  /' <<<"$status"; }
    # Commits recorded pulled or rejected are removed from the rebase todo:
    # rejected ones must not survive, and pulled-but-adapted ones (resolved
    # by hand against newer upstream code) would conflict against their
    # obsolete box form. Excluded commits are NOT dropped — they stay
    # box-only by design.
    local drops="" dsha ddisp _rest
    if [[ -f "$STATE_FILE" ]]; then
        while read -r dsha ddisp _rest; do
            [[ "$ddisp" == pulled || "$ddisp" == rejected ]] || continue
            grep -q "^+ $dsha" <<<"$cherry" && drops="$drops $dsha"
        done < "$STATE_FILE"
    fi
    if [[ -n "$drops" ]]; then
        info "these survivors are dispositioned ($(wc -w <<<"$drops" | tr -d ' ')) and will be DROPPED in the rebase:"
        local d
        for d in $drops; do
            printf '  %s  %s\n' "${d:0:7}" "$(grep "^+ $d" <<<"$cherry" | cut -d' ' -f3-)"
        done
    fi
    if [[ "$yes" -ne 1 ]]; then
        read -r -p "Rebase the box onto origin/main now? [y/N] " ans
        [[ "$ans" == y || "$ans" == Y ]] || { echo "aborted — box unchanged"; return 1; }
    fi

    local box_script
    box_script=$(cat <<EOS
g() { sudo -u shellm git -C /opt/shellm/app "\$@"; }
DROPS="$drops"
cat > /tmp/audel-todo-filter.sh <<'FEOF'
#!/bin/sh
# GIT_SEQUENCE_EDITOR: delete pick lines for dispositioned commits
todo="\$1"
cp "\$todo" "\$todo.orig"
awk -v drops="\$DROPS" '
    BEGIN { n = split(drops, D, " ") }
    /^pick / { for (i = 1; i <= n; i++) if (index(D[i], \$2) == 1) next }
    { print }
' "\$todo.orig" > "\$todo"
FEOF
chmod +x /tmp/audel-todo-filter.sh
stashed=0
if [ -n "\$(g status --porcelain)" ]; then
    g stash push -u -m audel-commits-reconcile >/dev/null && stashed=1
fi
if ! sudo -u shellm env DROPS="\$DROPS" GIT_SEQUENCE_EDITOR=/tmp/audel-todo-filter.sh GIT_EDITOR=true git -C /opt/shellm/app rebase -i origin/main; then
    g rebase --abort || true
    [ "\$stashed" -eq 1 ] && { g stash pop || true; }
    echo "rebase CONFLICT — aborted, box left as it was" >&2
    exit 1
fi
[ "\$stashed" -eq 1 ] && { g stash pop || echo "warning: stash pop conflicted — agent WIP left in the stash" >&2; }
echo "=== AFTER ==="
g log --reverse --oneline origin/main..main
g status --short
EOS
)
    run_script_on_box "$box_script" || die "reconcile failed — box unchanged"

    info "reconciled. If any commit was amended or rejected, the running agent still has the old code baked in:"
    cat <<EOF
  SHELLM_TF_STACK=$SHELLM_TF_STACK deploy/scripts/run 'sudo systemctl restart headlong-slack-agent'
  plus thinker-sync (dash sync button, or POST /api/identities/.identities~audel/thinker-sync)
EOF
}

case "${1:-}" in
    list)       shift; cmd_list "$@" ;;
    triage)     shift; cmd_triage "$@" ;;
    pull)       shift; cmd_pull "$@" ;;
    reject)     shift; cmd_reject "$@" ;;
    reconcile)  shift; cmd_reconcile "$@" ;;
    -h|--help|"") usage ;;
    *) usage 1 ;;
esac
