# headlong-thinkers-alert@<identity> systemd template unit. Installed by
# deploy/setup.sh (re-synced by deploy/update.sh), which substitutes
# @SHELLM_HOME@.
#
# Fired by headlong-thinkers@<identity>.service's OnFailure= when the
# dispatcher unit lands in a failed state — a dispatcher that died on its
# own, not a deliberate stop (clean stops don't fail the unit). The
# thinkers unit intentionally has no Restart=, so a failed unit is a mind
# that stays down until an operator acts; this alert turns that
# visible-but-silent state into a Slack message so it is noticed in
# minutes, not when someone pings the persona (on 2026-08-12 the mind was
# down for an hour before a human noticed).

[Unit]
Description=headlong thinkers failure alert for identity %i

[Service]
Type=oneshot
User=shellm
WorkingDirectory=@SHELLM_HOME@/app
# systemd reads the env file as root (the shellm user may not be able to);
# same pattern as headlong-slack-bridge.service. The script also tolerates a
# missing/unreadable file and falls back to sourcing it itself.
EnvironmentFile=-@SHELLM_HOME@/app/.env
ExecStart=/bin/bash @SHELLM_HOME@/app/deploy/thinkers-failure-alert.sh @SHELLM_HOME@/app %i
