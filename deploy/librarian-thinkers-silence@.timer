# librarian-thinkers-silence@<identity>.timer — runs the silence check every
# five minutes. Enabled per identity by deploy/update.sh and the identity
# bootstrap alongside librarian-thinkers@<identity>.service.

[Unit]
Description=librarian silence check timer for identity %i

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=librarian-thinkers-silence@%i.service

[Install]
WantedBy=timers.target
