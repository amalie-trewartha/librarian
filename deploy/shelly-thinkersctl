#!/usr/bin/env bash
set -euo pipefail

# shelly-thinkersctl — root-owned wrapper that lets the shellm user manage
# per-identity thinker units without a wildcard in sudoers. Installed to
# /usr/local/bin by deploy/setup.sh (also under the legacy name
# shellm-thinkersctl); the sudo rule (deploy/sudoers-shelly-thinkers)
# permits exactly these two paths and nothing else. A sudoers wildcard like
# `systemctl stop shelly-thinkers@*` would match spaces too
# (`stop shelly-thinkers@x sshd`), so the validation lives here instead.
#
# Usage: shelly-thinkersctl start|stop|restart|is-active IDENTITY

usage() {
    echo "usage: shelly-thinkersctl start|stop|restart|is-active IDENTITY" >&2
    exit 2
}

[[ $# -eq 2 ]] || usage
action="$1"
ident="$2"

case "$action" in
    start|stop|restart|is-active) ;;
    *) usage ;;
esac

# Identity names are directory names under .identities/ — keep the unit
# instance to one safe token.
[[ "$ident" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || {
    echo "error: invalid identity name: $ident" >&2
    exit 2
}

# Target whichever template is actually installed. During the shelly rename
# migration a box can be on either side of the cutover, and this wrapper is
# invoked from both the web control plane and Audel's own prompts — pick the
# live one rather than assuming. New name wins when both exist.
unit_prefix=shellm-thinkers
if [[ -f /etc/systemd/system/shelly-thinkers@.service ]]; then
    unit_prefix=shelly-thinkers
fi

exec /usr/bin/systemctl "$action" "${unit_prefix}@${ident}.service"
