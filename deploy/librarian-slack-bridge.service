# librarian-slack-bridge systemd unit. Installed by deploy/setup.sh (when
# SHELLM_INSTALL_SLACK_BRIDGE=1), which substitutes @SHELLM_HOME@.
#
# deploy/update.sh re-syncs this file on every deploy — put box-local
# changes in a drop-in (librarian-slack-bridge.service.d/override.conf).
#
# Socket Mode: the bridge dials OUT to Slack over a websocket; nothing
# listens. It talks to librarian-web on 127.0.0.1:8080 and tails the persona
# identity's trajectory file directly. Config comes from the root .env
# (SLACK_BOT_TOKEN, SLACK_APP_TOKEN, SHELLM_SLACK_IDENTITY).

[Unit]
Description=librarian Slack Socket Mode bridge
After=network-online.target librarian-web.service librarian-slack-agent.service
Wants=network-online.target

[Service]
Type=simple
User=shellm
WorkingDirectory=@SHELLM_HOME@/app
# '-' prefix: missing .env (first boot, before the SSM fetch lands) must not
# fail the unit — the bridge exits and Restart=always retries until it works.
EnvironmentFile=-@SHELLM_HOME@/app/.env
# The bridge tokens live apart from the root .env so the mind never sees
# them (deploy/split-bridge-env.sh); later files win, so a token still in
# .env is overridden by .env.bridge.
EnvironmentFile=-@SHELLM_HOME@/app/.env.bridge
Environment="PATH=@SHELLM_HOME@/.local/bin:@SHELLM_HOME@/.bun/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=@SHELLM_HOME@/app/tools/librarian-slack-bridge @SHELLM_HOME@/app
Restart=always
RestartSec=5
# Default KillMode is fine: the bridge spawns no agent processes.

# Kill switch: `systemctl stop librarian-slack-bridge` mutes Slack without
# touching the agent (tools/librarian-killall stops the agent itself).

[Install]
WantedBy=multi-user.target
