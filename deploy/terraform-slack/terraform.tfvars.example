# Copy to terraform.tfvars and fill in. No secrets belong here — the box's
# .env (API keys + Slack tokens) lives in the SSM parameter; see README.
# Gitignored anyway, and the state file DOES hold secrets (tunnel token).
#
# Seed the env parameter before terraform apply:
#   aws ssm put-parameter --name /shellm-slack/env --type SecureString \
#       --value "$(cat .env.slack)" --overwrite --region <region>
# where .env.slack holds the LLM API key(s) plus:
#   SLACK_BOT_TOKEN=xoxb-...
#   SLACK_APP_TOKEN=xapp-...
#   SHELLM_SLACK_IDENTITY=audel

aws_region = "us-east-1"

# Cloudflare — IDs are on the zone overview page / Zero Trust dashboard
cloudflare_account_id = "REPLACE_ME"
cloudflare_zone_id    = "REPLACE_ME"
domain                = "example.com"
subdomain             = "slack"

# The Slack box keeps its own env parameter, separate from the demo box's
env_parameter = "/shellm-slack/env"

# Dash access (observability) — Slack traffic itself never enters here;
# the bridge dials out via Socket Mode
allowed_emails = [
  "you@example.com",
]

# Optional: let a whole Google Workspace domain SSO into the dash. Create an
# OAuth client in Google Cloud console first (type Web application, redirect
# URI https://<team>.cloudflareaccess.com/cdn-cgi/access/callback) — see
# README for the consent-screen choice. Leave unset for OTP-only.
# allowed_email_domains  = ["example.com"]
# google_oauth_client_id = "1234-abc.apps.googleusercontent.com"
# Secret: prefer TF_VAR_google_oauth_client_secret from op via .envrc (see
# envrc.example). Setting it here works too (gitignored; state holds it
# regardless):
# google_oauth_client_secret = "GOCSPX-..."

# Optional email fallback for the box-down alerts (Slack is the primary
# path — see alerting.tf). SNS mails a confirmation link on first apply.
# alert_email = "you@example.com"
