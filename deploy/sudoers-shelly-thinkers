# Installed to /etc/sudoers.d/shelly-thinkers (0440 root:root) by
# deploy/setup.sh, after a visudo -cf syntax check. Allows the shellm web
# control plane (user shellm) to manage per-identity thinker units through
# the validating wrapper only — the wrapper whitelists the action and the
# identity name, so no wildcard is needed here.
#
# Both wrapper paths are permitted: sudo matches the command as invoked, and
# during the shelly rename migration callers exist for either name (Audel's
# own prompts, the web control plane's SHELLY_THINKERSCTL env). Drop the
# legacy line once nothing references it.
shellm ALL=(root) NOPASSWD: /usr/local/bin/shelly-thinkersctl
shellm ALL=(root) NOPASSWD: /usr/local/bin/shellm-thinkersctl
